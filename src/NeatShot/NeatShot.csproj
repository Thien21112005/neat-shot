<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NeatShot.ico</ApplicationIcon>

    <!-- Thông tin phiên bản & sản phẩm (hiển thị trong Properties của file exe) -->
    <Version>1.1.0</Version>
    <Product>NeatShot</Product>
    <AssemblyTitle>NeatShot</AssemblyTitle>
    <Description>Lightweight Windows screenshot tool with annotations, pin to screen and offline OCR.</Description>
    <Authors>Thien21112005</Authors>
    <Copyright>Copyright (c) 2026 Thien21112005</Copyright>
    <RepositoryUrl>https://github.com/Thien21112005/neat-shot</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon dùng chung cho exe và khay hệ thống (sinh bởi scripts/generate-icons.py) -->
    <EmbeddedResource Include="Assets\NeatShot.ico" LogicalName="NeatShot.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
