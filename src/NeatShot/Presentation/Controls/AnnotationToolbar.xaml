<UserControl x:Class="NeatShot.Presentation.Controls.AnnotationToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Background="{x:Null}">

    <UserControl.Resources>
        <!-- Style cho từng mục bên trong Popup Dropdown (Hiển thị icon + text đầy đủ, không bị cắt ngắn) -->
        <Style x:Key="ToolComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="1,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF0078D4" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template cho ShapeComboBox: Nút 32x30 hiển thị hình ▭ hoặc ◯ màu trắng tinh -->
        <ControlTemplate x:Key="ShapeComboBoxTemplate" TargetType="ComboBox">
            <Grid Width="32" Height="30" HorizontalAlignment="Center">
                <ToggleButton x:Name="ToggleButton"
                              Width="32"
                              Height="30"
                              Style="{x:Null}"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press"
                              Cursor="Hand"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border"
                                    Width="32"
                                    Height="30"
                                    CornerRadius="4"
                                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    SnapsToDevicePixels="True">
                                <Grid Width="32" Height="30">
                                    <!-- Biểu tượng chữ nhật / oval căn giữa, luôn có màu trắng tinh khiết -->
                                    <TextBlock x:Name="Glyph"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="▭" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="1">
                                                        <Setter Property="Text" Value="◯" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Dấu tam giác nhỏ màu trắng ở góc dưới bên phải -->
                                    <Path HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,2.5,2.5"
                                          Fill="#D0FFFFFF"
                                          Data="M 0 0 L 4 0 L 2 3 Z" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#FF0078D4" />
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFFFFFFF" />
                                    <Setter TargetName="Border" Property="BorderThickness" Value="1.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- Popup danh sách xổ xuống -->
                <Popup x:Name="PART_Popup"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       Placement="Right"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Border Background="#F01E1E1E"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="3"
                            MinWidth="150"
                            Effect="{DynamicResource {x:Static SystemParameters.DropShadow}}">
                        <ScrollViewer SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="PART_Popup" Property="Visibility" Value="Collapsed" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Template cho LineComboBox: Nút 32x30 hiển thị đường ↗ hoặc ― màu trắng tinh -->
        <ControlTemplate x:Key="LineComboBoxTemplate" TargetType="ComboBox">
            <Grid Width="32" Height="30" HorizontalAlignment="Center">
                <ToggleButton x:Name="ToggleButton"
                              Width="32"
                              Height="30"
                              Style="{x:Null}"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press"
                              Cursor="Hand"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border"
                                    Width="32"
                                    Height="30"
                                    CornerRadius="4"
                                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    SnapsToDevicePixels="True">
                                <Grid Width="32" Height="30">
                                    <!-- Biểu tượng mũi tên / đường thẳng căn giữa, luôn có màu trắng tinh khiết -->
                                    <TextBlock x:Name="Glyph"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="↗" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="1">
                                                        <Setter Property="Text" Value="―" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Dấu tam giác nhỏ màu trắng ở góc dưới bên phải -->
                                    <Path HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,2.5,2.5"
                                          Fill="#D0FFFFFF"
                                          Data="M 0 0 L 4 0 L 2 3 Z" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#FF0078D4" />
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFFFFFFF" />
                                    <Setter TargetName="Border" Property="BorderThickness" Value="1.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- Popup danh sách xổ xuống -->
                <Popup x:Name="PART_Popup"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       Placement="Right"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Border Background="#F01E1E1E"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="3"
                            MinWidth="150"
                            Effect="{DynamicResource {x:Static SystemParameters.DropShadow}}">
                        <ScrollViewer SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="PART_Popup" Property="Visibility" Value="Collapsed" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ShapeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,1.5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ToolComboBoxItemStyle}" />
            <Setter Property="Template" Value="{StaticResource ShapeComboBoxTemplate}" />
        </Style>

        <Style x:Key="LineComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,1.5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ToolComboBoxItemStyle}" />
            <Setter Property="Template" Value="{StaticResource LineComboBoxTemplate}" />
        </Style>
    </UserControl.Resources>

    <!-- Canvas chứa 2 thanh công cụ tách biệt chuẩn phong cách Lightshot (Thanh dọc vẽ + Thanh ngang tác vụ) -->
    <Canvas x:Name="ToolbarCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <!-- 1. THANH DỌC CÔNG CỤ VẼ & CHÚ THÍCH (Vertical Drawing Toolbar - Cạnh phải vùng chọn) -->
        <Border x:Name="VerticalBar"
                Width="42"
                Background="#F01E1E1E"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4,6"
                Effect="{DynamicResource {x:Static SystemParameters.DropShadow}}">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <!-- Tay cầm kéo di chuyển thanh công cụ tự do (Drag Grip) -->
                <Border x:Name="DragGrip"
                        Width="32"
                        Height="14"
                        Cursor="SizeAll"
                        Background="Transparent"
                        Padding="0,1,0,3"
                        HorizontalAlignment="Center"
                        ToolTip="Bấm giữ để di chuyển thanh công cụ tự do (Nháy đúp để tự động căn lại vị trí)"
                        MouseLeftButtonDown="OnDragGripMouseDown"
                        MouseMove="OnDragGripMouseMove"
                        MouseLeftButtonUp="OnDragGripMouseUp">
                    <TextBlock Text="⋮⋮"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#80FFFFFF"
                                HorizontalAlignment="Center" />
                </Border>

                <!-- Nút Chọn & Di chuyển (Select) -->
                <Button x:Name="SelectButton"
                        Width="32"
                        Height="30"
                        Margin="0,1.5"
                        Padding="0"
                        HorizontalAlignment="Center"
                        ToolTip="Chọn &amp; di chuyển hình vẽ (Click chuột phải để di chuyển khung chụp)"
                        Click="OnSelectClick">
                    <TextBlock Text="👆" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Nút Bút chì (Pencil) -->
                <Button x:Name="PencilButton"
                        Width="32"
                        Height="30"
                        Margin="0,1.5"
                        Padding="0"
                        HorizontalAlignment="Center"
                        ToolTip="Bút vẽ tự do (P)"
                        Click="OnPencilClick">
                    <TextBlock Text="✏️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Ô thả xuống Hình khối: Hiển thị biểu tượng ▭ / ◯ rõ ràng -->
                <ComboBox x:Name="ShapeComboBox"
                          Width="32"
                          Height="30"
                          Style="{StaticResource ShapeComboBoxStyle}"
                          ToolTip="Hình khối: Chữ nhật (R) hoặc Oval (O)"
                          PreviewMouseLeftButtonDown="OnShapeComboBoxPreviewMouseDown"
                          SelectionChanged="OnShapeComboBoxSelectionChanged"
                          DropDownOpened="OnShapeComboBoxDropDownOpened">
                    <ComboBoxItem Tag="Rectangle" IsSelected="True" ToolTip="Hình chữ nhật (R)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="▭" FontSize="14" FontWeight="Bold" Foreground="White" Width="22" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="Chữ nhật (R)" FontSize="12" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Ellipse" ToolTip="Hình tròn / Oval (O)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="◯" FontSize="14" FontWeight="Bold" Foreground="White" Width="22" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="Oval / Tròn (O)" FontSize="12" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <!-- Ô thả xuống Đường kẻ: Hiển thị biểu tượng ↗ / ― rõ ràng -->
                <ComboBox x:Name="LineComboBox"
                          Width="32"
                          Height="30"
                          Style="{StaticResource LineComboBoxStyle}"
                          ToolTip="Đường kẻ: Mũi tên (A) hoặc Đường thẳng (L)"
                          PreviewMouseLeftButtonDown="OnLineComboBoxPreviewMouseDown"
                          SelectionChanged="OnLineComboBoxSelectionChanged"
                          DropDownOpened="OnLineComboBoxDropDownOpened">
                    <ComboBoxItem Tag="Arrow" IsSelected="True" ToolTip="Mũi tên (A)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↗" FontSize="14" FontWeight="Bold" Foreground="White" Width="22" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="Mũi tên (A)" FontSize="12" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Line" ToolTip="Đường thẳng (L)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="―" FontSize="14" FontWeight="Bold" Foreground="White" Width="22" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="Đường thẳng (L)" FontSize="12" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <!-- Các nút ẩn giữ tương thích API và kiểm thử tự động -->
                <Button x:Name="RectButton" Visibility="Collapsed" Click="OnRectClick" />
                <Button x:Name="EllipseButton" Visibility="Collapsed" Click="OnEllipseClick" />
                <Button x:Name="LineButton" Visibility="Collapsed" Click="OnLineClick" />
                <Button x:Name="ArrowButton" Visibility="Collapsed" Click="OnArrowClick" />

                <!-- Nút Bút dạ quang (Highlight) -->
                <Button x:Name="HighlightButton"
                        Width="32"
                        Height="30"
                        Margin="0,1.5"
                        Padding="0"
                        HorizontalAlignment="Center"
                        ToolTip="Bút dạ quang highlight (H)"
                        Click="OnHighlightClick">
                    <TextBlock Text="🖍️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Nút Chèn văn bản (Text) -->
                <Button x:Name="TextButton"
                        Width="32"
                        Height="30"
                        Margin="0,1.5"
                        Padding="0"
                        HorizontalAlignment="Center"
                        ToolTip="Chèn chữ văn bản (T)"
                        Click="OnTextClick">
                    <TextBlock Text="T" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Nút Khảm ô vuông (Pixelate / Mosaic) -->
                <Button x:Name="PixelateButton"
                        Width="32"
                        Height="30"
                        Margin="0,1.5"
                        Padding="0"
                        HorizontalAlignment="Center"
                        ToolTip="Khảm ô vuông che thông tin nhạy cảm (B)"
                        Click="OnPixelateClick">
                    <TextBlock Text="🧊" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Nút Làm mờ (Blur) -->
                <Button x:Name="BlurButton"
                        Width="32"
                        Height="30"
                        Margin="0,1.5"
                        Padding="0"
                        HorizontalAlignment="Center"
                        ToolTip="Làm mờ che thông tin nhạy cảm (Blur)"
                        Click="OnBlurClick">
                    <TextBlock Text="🌫️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Nút Đánh số bước tự động (Step Counter) -->
                <Button x:Name="StepCounterButton"
                        Width="32"
                        Height="30"
                        Margin="0,1.5"
                        Padding="0"
                        HorizontalAlignment="Center"
                        ToolTip="Đánh số bước tự động (N)"
                        Click="OnStepCounterClick">
                    <TextBlock Text="①" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Nhóm công cụ chọn màu & lịch sử màu (Chỉ hiển thị khi đang bật công cụ vẽ dùng màu, ẩn khi cắt/kéo/none) -->
                <StackPanel x:Name="ColorPalettePanel" Orientation="Vertical" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Separator Margin="2,4" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                    <!-- Nút Cây bút hút màu (Eyedropper) -->
                    <Button x:Name="EyedropperButton"
                            Width="32"
                            Height="30"
                            Margin="0,1.5"
                            Padding="0"
                            HorizontalAlignment="Center"
                            ToolTip="Cây bút hút màu màn hình (I)"
                            Click="OnEyedropperClick">
                        <TextBlock Text="💉" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Separator Margin="2,3" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                    <!-- Bảng màu mặc định (xếp dọc 1 cột đồng bộ kích thước) -->
                    <Button x:Name="ColorRedButton" ToolTip="Màu đỏ" Width="32" Height="22" Margin="0,1" Padding="2" HorizontalAlignment="Center" Click="OnColorSelect" Tag="#FFE81123">
                        <Border Width="14" Height="14" CornerRadius="7" Background="#FFE81123" />
                    </Button>
                    <Button x:Name="ColorYellowButton" ToolTip="Màu vàng" Width="32" Height="22" Margin="0,1" Padding="2" HorizontalAlignment="Center" Click="OnColorSelect" Tag="#FFFFB900">
                        <Border Width="14" Height="14" CornerRadius="7" Background="#FFFFB900" />
                    </Button>
                    <Button x:Name="ColorGreenButton" ToolTip="Màu xanh lá" Width="32" Height="22" Margin="0,1" Padding="2" HorizontalAlignment="Center" Click="OnColorSelect" Tag="#FF107C41">
                        <Border Width="14" Height="14" CornerRadius="7" Background="#FF107C41" />
                    </Button>
                    <Button x:Name="ColorBlueButton" ToolTip="Màu xanh dương" Width="32" Height="22" Margin="0,1" Padding="2" HorizontalAlignment="Center" Click="OnColorSelect" Tag="#FF0078D4">
                        <Border Width="14" Height="14" CornerRadius="7" Background="#FF0078D4" />
                    </Button>
                    <Button x:Name="ColorWhiteButton" ToolTip="Màu trắng" Width="32" Height="22" Margin="0,1" Padding="2" HorizontalAlignment="Center" Click="OnColorSelect" Tag="#FFFFFFFF">
                        <Border Width="14" Height="14" CornerRadius="7" Background="#FFFFFFFF" />
                    </Button>

                    <!-- Lịch sử các màu đã chọn/hút gần đây (Color History) -->
                    <StackPanel x:Name="HistoryColorsPanel" Orientation="Vertical" Margin="0,2" HorizontalAlignment="Center" />
                </StackPanel>

                <Separator Margin="2,4" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                <!-- Nút Hoàn tác (Undo) -->
                <Button x:Name="UndoButton"
                        Width="32"
                        Height="30"
                        Margin="0,1.5"
                        Padding="0"
                        HorizontalAlignment="Center"
                        ToolTip="Hoàn tác nét vẽ (Ctrl + Z)"
                        Click="OnUndoClick">
                    <TextBlock Text="↩" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Nút Làm lại (Redo) -->
                <Button x:Name="RedoButton"
                        Width="32"
                        Height="30"
                        Margin="0,1.5"
                        Padding="0"
                        HorizontalAlignment="Center"
                        ToolTip="Làm lại nét vẽ (Ctrl + Y)"
                        Click="OnRedoClick">
                    <TextBlock Text="↪" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. THANH PHỤ TUỲ CHỌN NỔI (Secondary Flyout: Kích thước số bước & Cỡ chữ khi kích hoạt) -->
        <Border x:Name="FlyoutOptionsPanel"
                Visibility="Collapsed"
                Background="#F01E1E1E"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6,4"
                Effect="{DynamicResource {x:Static SystemParameters.DropShadow}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Bảng tùy chọn kích thước đánh số bước (Step Counter Size) -->
                <StackPanel x:Name="StepSizeControlsPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Cỡ số:" FontSize="12" VerticalAlignment="Center" Margin="2,0,4,0" Foreground="#CCCCCC" ToolTip="Kích thước ô đánh số bước" />
                    <ComboBox x:Name="StepSizeComboBox"
                              Width="80"
                              Height="28"
                              MaxDropDownHeight="180"
                              Margin="2,0"
                              Padding="4,2"
                              VerticalContentAlignment="Center"
                              ToolTip="Chọn kích thước ô số bước"
                              SelectionChanged="OnStepSizeSelectionChanged">
                        <ComboBoxItem Content="Nhỏ (11)" Tag="11" />
                        <ComboBoxItem Content="Vừa (14)" Tag="14" IsSelected="True" />
                        <ComboBoxItem Content="Lớn (18)" Tag="18" />
                        <ComboBoxItem Content="Rất lớn (24)" Tag="24" />
                    </ComboBox>
                </StackPanel>

                <!-- Bảng tùy chọn Phông chữ & Cỡ chữ khi kích hoạt Text -->
                <StackPanel x:Name="FontControlsPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="🔤" FontSize="12" VerticalAlignment="Center" Margin="2,0,4,0" ToolTip="Tùy chọn phông chữ và cỡ chữ" />
                    <ComboBox x:Name="FontFamilyComboBox"
                              Width="105"
                              Height="28"
                              MaxDropDownHeight="180"
                              Margin="2,0"
                              Padding="4,2"
                              VerticalContentAlignment="Center"
                              ToolTip="Chọn phông chữ"
                              SelectionChanged="OnFontFamilySelectionChanged">
                        <ComboBoxItem Content="Segoe UI" IsSelected="True" />
                        <ComboBoxItem Content="Arial" />
                        <ComboBoxItem Content="Calibri" />
                        <ComboBoxItem Content="Consolas" />
                        <ComboBoxItem Content="Times New Roman" />
                        <ComboBoxItem Content="Verdana" />
                        <ComboBoxItem Content="Tahoma" />
                        <ComboBoxItem Content="Courier New" />
                    </ComboBox>
                    <ComboBox x:Name="FontSizeComboBox"
                              Width="55"
                              Height="28"
                              MaxDropDownHeight="180"
                              Margin="2,0"
                              Padding="4,2"
                              VerticalContentAlignment="Center"
                              ToolTip="Chọn cỡ chữ"
                              SelectionChanged="OnFontSizeSelectionChanged">
                        <ComboBoxItem Content="12" />
                        <ComboBoxItem Content="14" />
                        <ComboBoxItem Content="16" IsSelected="True" />
                        <ComboBoxItem Content="18" />
                        <ComboBoxItem Content="20" />
                        <ComboBoxItem Content="24" />
                        <ComboBoxItem Content="28" />
                        <ComboBoxItem Content="32" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. THANH NGANG TÁC VỤ KẾT QUẢ (Horizontal Action Toolbar - Cạnh dưới bên phải vùng chọn) -->
        <Border x:Name="HorizontalBar"
                Background="#F01E1E1E"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6,4"
                Effect="{DynamicResource {x:Static SystemParameters.DropShadow}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Nút Ghim lên màn hình (Pin to Screen) -->
                <Button x:Name="PinButton"
                        ToolTip="Ghim ảnh nổi trên màn hình (Pin)"
                        Margin="2,0"
                        Padding="6,4"
                        Click="OnPinClick">
                    <TextBlock Text="📌" FontSize="13" />
                </Button>

                <!-- Nút Nhận diện chữ tức thì (Quick OCR) -->
                <Button x:Name="OcrButton"
                        ToolTip="Trích xuất chữ vào Clipboard (OCR)"
                        Margin="2,0"
                        Padding="6,4"
                        Click="OnOcrClick">
                    <TextBlock Text="OCR" FontWeight="SemiBold" FontSize="11" />
                </Button>

                <!-- Tùy chọn Làm đẹp ảnh (Beautify: Padding, Shadow & Gradient) -->
                <ComboBox x:Name="BeautifyComboBox"
                          ToolTip="Làm đẹp ảnh: Đổ bóng, bo góc &amp; nền Gradient"
                          Margin="2,0"
                          Height="28"
                          MaxDropDownHeight="240"
                          Padding="6,2"
                          VerticalContentAlignment="Center"
                          SelectionChanged="OnBeautifySelectionChanged">
                    <ComboBoxItem Content="✨ Gốc" Tag="None" IsSelected="True" />
                    <ComboBoxItem Content="🌅 Sunset" Tag="Sunset" />
                    <ComboBoxItem Content="🌊 Ocean" Tag="Ocean" />
                    <ComboBoxItem Content="🔮 Purple" Tag="Purple" />
                    <ComboBoxItem Content="🌑 Dark Slate" Tag="DarkSlate" />
                </ComboBox>

                <!-- Nút ẩn BeautifyButton phục vụ API và kiểm thử -->
                <Button x:Name="BeautifyButton" Visibility="Collapsed" Click="OnBeautifyButtonClick" />

                <Separator Margin="4,2" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                <!-- Nút Copy vào Clipboard -->
                <Button x:Name="CopyButton"
                        ToolTip="Sao chép vào Clipboard (Enter)"
                        Background="#FF0078D4"
                        Foreground="White"
                        Margin="2,0"
                        Padding="8,4"
                        Click="OnCopyClick">
                    <TextBlock Text="Sao chép" FontWeight="SemiBold" FontSize="12" />
                </Button>

                <!-- Nút Lưu file ảnh -->
                <Button x:Name="SaveButton"
                        ToolTip="Lưu file ảnh PNG (Ctrl + S)"
                        Margin="2,0"
                        Padding="8,4"
                        Click="OnSaveClick">
                    <TextBlock Text="Lưu" FontSize="12" />
                </Button>

                <!-- Nút Hủy / Đóng -->
                <Button x:Name="CloseButton"
                        ToolTip="Đóng (Esc)"
                        Margin="2,0"
                        Padding="6,4"
                        Click="OnCloseClick">
                    <TextBlock Text="✕" FontSize="12" />
                </Button>
            </StackPanel>
        </Border>

    </Canvas>
</UserControl>
