<UserControl x:Class="NeatShot.Presentation.Controls.AnnotationToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{x:Null}">

    <UserControl.Resources>
        <!-- ============ Bảng màu & kích thước (đồng bộ với landing page) ============ -->
        <SolidColorBrush x:Key="BarBackgroundBrush" Color="#F716181D" />
        <SolidColorBrush x:Key="BarBorderBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="IconBrush" Color="#C9CDD2" />
        <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="PressedOverlayBrush" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4" />

        <DropShadowEffect x:Key="BarShadow" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.45" Color="Black" />

        <!-- ============ Bộ icon nét mảnh (lưới 24×24, giống bộ icon SVG của landing page) ============ -->
        <Geometry x:Key="IconGrip">M6,9 h0.01 M12,9 h0.01 M18,9 h0.01 M6,15 h0.01 M12,15 h0.01 M18,15 h0.01</Geometry>
        <Geometry x:Key="IconSelect">M5,4 L18,10.5 L12.4,12.1 L10,18 Z M12.4,12.1 L17,17</Geometry>
        <Geometry x:Key="IconPencil">M4,20 L5,16 L16,5 L19,8 L8,19 Z M14,7 L17,10</Geometry>
        <Geometry x:Key="IconHighlighter">M15,4 L20,9 L12,17 H8 V13 Z M4,20 H12</Geometry>
        <Geometry x:Key="IconRect">M5.5,6 H18.5 A1.5,1.5 0 0 1 20,7.5 V16.5 A1.5,1.5 0 0 1 18.5,18 H5.5 A1.5,1.5 0 0 1 4,16.5 V7.5 A1.5,1.5 0 0 1 5.5,6 Z</Geometry>
        <Geometry x:Key="IconEllipse">M3.5,12 A8.5,6.5 0 1 0 20.5,12 A8.5,6.5 0 1 0 3.5,12 Z</Geometry>
        <Geometry x:Key="IconLine">M5,19 L19,5</Geometry>
        <Geometry x:Key="IconArrow">M5,19 L19,5 M10,5 H19 V14</Geometry>
        <Geometry x:Key="IconText">M5,6 H19 M12,6 V19 M9,19 H15</Geometry>
        <Geometry x:Key="IconStep">M3.5,12 A8.5,8.5 0 1 0 20.5,12 A8.5,8.5 0 1 0 3.5,12 Z M10.5,9.5 L12.5,8 V16</Geometry>
        <Geometry x:Key="IconPixelate">M4,4 h5 v5 H4 Z M15,4 h5 v5 h-5 Z M9.5,9.5 h5 v5 h-5 Z M4,15 h5 v5 H4 Z M15,15 h5 v5 h-5 Z</Geometry>
        <Geometry x:Key="IconBlur">M12,3.5 C15.2,7.7 18,10.8 18,14 A6,6 0 0 1 6,14 C6,10.8 8.8,7.7 12,3.5 Z M9.5,14.5 A2.5,2.5 0 0 0 12,17</Geometry>
        <Geometry x:Key="IconDropper">M16.5,4.5 A2.1,2.1 0 0 1 19.5,7.5 L17,10 L14,7 Z M14,7 L5.5,15.5 L5,19 L8.5,18.5 L17,10</Geometry>
        <Geometry x:Key="IconUndo">M9,14 L4,9 L9,4 M4,9 H14.5 A5.5,5.5 0 0 1 14.5,20 H11</Geometry>
        <Geometry x:Key="IconRedo">M15,14 L20,9 L15,4 M20,9 H9.5 A5.5,5.5 0 0 0 9.5,20 H13</Geometry>
        <Geometry x:Key="IconPin">M9,3.5 H15 M10,3.5 V9 L7,13 H17 L14,9 V3.5 M12,13 V20.5</Geometry>
        <Geometry x:Key="IconOcr">M8,4 H5 V20 H8 M16,4 H19 V20 H16 M9,8.5 H15 M12,8.5 V16</Geometry>
        <Geometry x:Key="IconSparkle">M12,3.5 L13.9,8.6 L19,10.5 L13.9,12.4 L12,17.5 L10.1,12.4 L5,10.5 L10.1,8.6 Z M18.5,15.5 L19.3,17.7 L21.5,18.5 L19.3,19.3 L18.5,21.5 L17.7,19.3 L15.5,18.5 L17.7,17.7 Z</Geometry>
        <Geometry x:Key="IconCopy">M10,8 H18 A2,2 0 0 1 20,10 V18 A2,2 0 0 1 18,20 H10 A2,2 0 0 1 8,18 V10 A2,2 0 0 1 10,8 Z M16,8 V6 A2,2 0 0 0 14,4 H6 A2,2 0 0 0 4,6 V14 A2,2 0 0 0 6,16 H8</Geometry>
        <Geometry x:Key="IconSave">M12,4 V15 M7.5,10.5 L12,15 L16.5,10.5 M5,20 H19</Geometry>
        <Geometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</Geometry>
        <Geometry x:Key="IconFont">M4,19 L9.5,5 L15,19 M6.2,14 H12.8 M16,19 V11 M16,13 A3,3 0 0 1 22,13 V19</Geometry>
        <Geometry x:Key="IconCaret">M0,0 L5,0 L2.5,3 Z</Geometry>

        <!-- Path vẽ icon: nét theo màu chữ (Foreground) của nút chứa nó -->
        <Style x:Key="IconPathStyle" TargetType="Path">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Fill" Value="{x:Null}" />
            <Setter Property="StrokeThickness" Value="1.75" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style x:Key="IconBoxStyle" TargetType="Viewbox">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============ Nút công cụ: nền trong suốt, hover phủ sáng nhẹ, đang chọn = nền xanh đặc ============ -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True" />
                            <Border x:Name="Overlay" CornerRadius="5" Background="{StaticResource HoverOverlayBrush}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{StaticResource PressedOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút tác vụ chính (Sao chép): nền xanh, icon + chữ -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Padding" Value="10,0,12,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Nút tác vụ có chữ (Trích xuất chữ) -->
        <Style x:Key="TextActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="1,0" />
        </Style>

        <!-- Vạch ngăn nhóm -->
        <Style x:Key="BarSeparatorH" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,5" />
            <Setter Property="Background" Value="{StaticResource SeparatorBrush}" />
        </Style>
        <Style x:Key="BarSeparatorV" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Background" Value="{StaticResource SeparatorBrush}" />
        </Style>

        <!-- Khung thanh công cụ -->
        <Style x:Key="BarBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BarBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect" Value="{StaticResource BarShadow}" />
        </Style>

        <!-- ============ Dropdown Hình khối / Đường kẻ ============ -->
        <Style x:Key="ToolComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="5"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template chung: nút 32×30 hiển thị icon của lựa chọn hiện tại + mũi tên nhỏ ở góc -->
        <ControlTemplate x:Key="ToolDropdownTemplate" TargetType="ComboBox">
            <Grid Width="32" Height="30" HorizontalAlignment="Center">
                <ToggleButton x:Name="ToggleButton"
                              Width="32"
                              Height="30"
                              Focusable="False"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press"
                              Cursor="Hand">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid Width="32" Height="30">
                                <Border CornerRadius="5"
                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        SnapsToDevicePixels="True" />
                                <Border x:Name="Overlay" CornerRadius="5" Background="{StaticResource HoverOverlayBrush}" Opacity="0" />
                                <Viewbox Style="{StaticResource IconBoxStyle}">
                                    <Path x:Name="Glyph"
                                          Style="{StaticResource IconPathStyle}"
                                          Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                </Viewbox>
                                <Path HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,3,3"
                                      Data="{StaticResource IconCaret}"
                                      Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                      Opacity="0.7" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                    <Setter TargetName="Overlay" Property="Background" Value="{StaticResource PressedOverlayBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Popup x:Name="PART_Popup"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       StaysOpen="False"
                       Placement="Right"
                       HorizontalOffset="6"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                    <Border Style="{StaticResource BarBorderStyle}" Padding="4" MinWidth="160" Margin="0,0,12,12">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="PART_Popup" Property="Visibility" Value="Collapsed" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ToolDropdownStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ToolComboBoxItemStyle}" />
            <Setter Property="Template" Value="{StaticResource ToolDropdownTemplate}" />
        </Style>

        <!-- Icon trong nút dropdown đổi theo lựa chọn (Tag mang Geometry của icon) -->
        <Style x:Key="ShapeComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ToolDropdownStyle}">
            <Setter Property="Tag" Value="{StaticResource IconRect}" />
            <Style.Triggers>
                <Trigger Property="SelectedIndex" Value="1">
                    <Setter Property="Tag" Value="{StaticResource IconEllipse}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LineComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ToolDropdownStyle}">
            <Setter Property="Tag" Value="{StaticResource IconArrow}" />
            <Style.Triggers>
                <Trigger Property="SelectedIndex" Value="1">
                    <Setter Property="Tag" Value="{StaticResource IconLine}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Ô chọn dạng thanh (Beautify): nền tối, chữ + mũi tên xổ xuống ============ -->
        <Style x:Key="BarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="10,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BarBorderBrush}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ToolComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border CornerRadius="5"
                                                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderThickness="1"
                                                    SnapsToDevicePixels="True" />
                                            <Border x:Name="Overlay" CornerRadius="5" Background="{StaticResource HoverOverlayBrush}" Opacity="0" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <DockPanel Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <Path DockPanel.Dock="Right"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L4,4 L8,0"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <ContentPresenter VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            </DockPanel>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   StaysOpen="False"
                                   Placement="Top"
                                   VerticalOffset="-6"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Style="{StaticResource BarBorderStyle}" Padding="4" Margin="12,12,12,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Nút chọn màu: chấm tròn, màu đang chọn có vòng trắng ============ -->
        <Style x:Key="ColorButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="32" Height="26">
                            <Border x:Name="Overlay" CornerRadius="5" Background="{StaticResource HoverOverlayBrush}" Opacity="0" />
                            <Border Width="22" Height="22"
                                    CornerRadius="11"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Nút tăng/giảm cỡ số & cỡ chữ ============ -->
        <Style x:Key="SpinButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SpinBorder"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SpinBorder" Property="Background" Value="#2EFFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SpinBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SpinBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlyoutLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,6,0" />
        </Style>
    </UserControl.Resources>

    <!-- Canvas chứa 2 thanh công cụ (thanh dọc: công cụ vẽ · thanh ngang: tác vụ) -->
    <Canvas x:Name="ToolbarCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <!-- 1. THANH DỌC CÔNG CỤ VẼ & CHÚ THÍCH -->
        <Border x:Name="VerticalBar"
                Width="42"
                Padding="4,4"
                Style="{StaticResource BarBorderStyle}">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <!-- Tay cầm kéo di chuyển thanh công cụ -->
                <Border x:Name="DragGrip"
                        Width="32"
                        Height="14"
                        Cursor="SizeAll"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        ToolTip="Bấm giữ để di chuyển thanh công cụ tự do (Nháy đúp để tự động căn lại vị trí)"
                        MouseLeftButtonDown="OnDragGripMouseDown"
                        MouseMove="OnDragGripMouseMove"
                        MouseLeftButtonUp="OnDragGripMouseUp">
                    <Viewbox Width="18" Height="12" TextElement.Foreground="#66FFFFFF">
                        <Path Style="{StaticResource IconPathStyle}" StrokeThickness="2.6" Data="{StaticResource IconGrip}" />
                    </Viewbox>
                </Border>

                <Button x:Name="SelectButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Chọn &amp; di chuyển hình vẽ (V) — Chuột phải để di chuyển khung chụp"
                        Click="OnSelectClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconSelect}" /></Viewbox>
                </Button>

                <Button x:Name="PencilButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Bút vẽ tự do (P)"
                        Click="OnPencilClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconPencil}" /></Viewbox>
                </Button>

                <!-- Dropdown Hình khối: Chữ nhật / Oval (chuột phải để đổi) -->
                <ComboBox x:Name="ShapeComboBox"
                          Width="32"
                          Height="30"
                          Style="{StaticResource ShapeComboBoxStyle}"
                          ToolTip="Hình khối: Chữ nhật (R) hoặc Oval (O) — Chuột phải để đổi hình"
                          PreviewMouseDown="OnShapeComboBoxPreviewMouseDown"
                          SelectionChanged="OnShapeComboBoxSelectionChanged"
                          DropDownOpened="OnShapeComboBoxDropDownOpened">
                    <ComboBoxItem Tag="Rectangle" IsSelected="True" ToolTip="Hình chữ nhật (R)"
                                  PreviewMouseLeftButtonUp="OnShapeItemPreviewMouseUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Style="{StaticResource IconBoxStyle}" Width="16" Height="16"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconRect}" /></Viewbox>
                            <TextBlock Text="Chữ nhật (R)" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Ellipse" ToolTip="Hình tròn / Oval (O)"
                                  PreviewMouseLeftButtonUp="OnShapeItemPreviewMouseUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Style="{StaticResource IconBoxStyle}" Width="16" Height="16"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconEllipse}" /></Viewbox>
                            <TextBlock Text="Oval / Tròn (O)" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <!-- Dropdown Đường kẻ: Mũi tên / Đường thẳng (chuột phải để đổi) -->
                <ComboBox x:Name="LineComboBox"
                          Width="32"
                          Height="30"
                          Style="{StaticResource LineComboBoxStyle}"
                          ToolTip="Đường kẻ: Mũi tên (A) hoặc Đường thẳng (L) — Chuột phải để đổi đường kẻ"
                          PreviewMouseDown="OnLineComboBoxPreviewMouseDown"
                          SelectionChanged="OnLineComboBoxSelectionChanged"
                          DropDownOpened="OnLineComboBoxDropDownOpened">
                    <ComboBoxItem Tag="Arrow" IsSelected="True" ToolTip="Mũi tên (A)"
                                  PreviewMouseLeftButtonUp="OnLineItemPreviewMouseUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Style="{StaticResource IconBoxStyle}" Width="16" Height="16"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconArrow}" /></Viewbox>
                            <TextBlock Text="Mũi tên (A)" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Line" ToolTip="Đường thẳng (L)"
                                  PreviewMouseLeftButtonUp="OnLineItemPreviewMouseUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Style="{StaticResource IconBoxStyle}" Width="16" Height="16"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconLine}" /></Viewbox>
                            <TextBlock Text="Đường thẳng (L)" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <!-- Các nút ẩn giữ tương thích API và kiểm thử tự động -->
                <Button x:Name="RectButton" Visibility="Collapsed" Click="OnRectClick" />
                <Button x:Name="EllipseButton" Visibility="Collapsed" Click="OnEllipseClick" />
                <Button x:Name="LineButton" Visibility="Collapsed" Click="OnLineClick" />
                <Button x:Name="ArrowButton" Visibility="Collapsed" Click="OnArrowClick" />

                <Button x:Name="HighlightButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Bút dạ quang (H)"
                        Click="OnHighlightClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconHighlighter}" /></Viewbox>
                </Button>

                <Button x:Name="TextButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Chèn chữ (T)"
                        Click="OnTextClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconText}" /></Viewbox>
                </Button>

                <Button x:Name="StepCounterButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Đánh số bước tự động (N)"
                        Click="OnStepCounterClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconStep}" /></Viewbox>
                </Button>

                <Button x:Name="PixelateButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Khảm ô vuông che thông tin nhạy cảm (B)"
                        Click="OnPixelateClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconPixelate}" /></Viewbox>
                </Button>

                <Button x:Name="BlurButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Làm mờ che thông tin nhạy cảm"
                        Click="OnBlurClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconBlur}" /></Viewbox>
                </Button>

                <!-- Nhóm màu & hút màu (chỉ hiện khi công cụ đang dùng màu) -->
                <StackPanel x:Name="ColorPalettePanel" Orientation="Vertical" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Border Style="{StaticResource BarSeparatorH}" />

                    <Button x:Name="EyedropperButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Hút màu trên màn hình (I)"
                            Click="OnEyedropperClick">
                        <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconDropper}" /></Viewbox>
                    </Button>

                    <Button x:Name="ColorRedButton" Style="{StaticResource ColorButtonStyle}" ToolTip="Màu đỏ" Click="OnColorSelect" Tag="#FFE81123">
                        <Ellipse Width="14" Height="14" Fill="#FFE81123" />
                    </Button>
                    <Button x:Name="ColorYellowButton" Style="{StaticResource ColorButtonStyle}" ToolTip="Màu vàng" Click="OnColorSelect" Tag="#FFFFB900">
                        <Ellipse Width="14" Height="14" Fill="#FFFFB900" />
                    </Button>
                    <Button x:Name="ColorGreenButton" Style="{StaticResource ColorButtonStyle}" ToolTip="Màu xanh lá" Click="OnColorSelect" Tag="#FF107C41">
                        <Ellipse Width="14" Height="14" Fill="#FF107C41" />
                    </Button>
                    <Button x:Name="ColorBlueButton" Style="{StaticResource ColorButtonStyle}" ToolTip="Màu xanh dương" Click="OnColorSelect" Tag="#FF0078D4">
                        <Ellipse Width="14" Height="14" Fill="#FF0078D4" />
                    </Button>
                    <Button x:Name="ColorWhiteButton" Style="{StaticResource ColorButtonStyle}" ToolTip="Màu trắng" Click="OnColorSelect" Tag="#FFFFFFFF">
                        <Ellipse Width="14" Height="14" Fill="#FFFFFFFF" />
                    </Button>

                    <!-- Lịch sử màu gần đây -->
                    <StackPanel x:Name="HistoryColorsPanel" Orientation="Vertical" Margin="0,2" HorizontalAlignment="Center" />
                </StackPanel>

                <Border Style="{StaticResource BarSeparatorH}" />

                <Button x:Name="UndoButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Hoàn tác (Ctrl + Z)"
                        Click="OnUndoClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconUndo}" /></Viewbox>
                </Button>

                <Button x:Name="RedoButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Làm lại (Ctrl + Y)"
                        Click="OnRedoClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconRedo}" /></Viewbox>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. FLYOUT TUỲ CHỌN (cỡ số bước / phông & cỡ chữ) -->
        <Border x:Name="FlyoutOptionsPanel"
                Visibility="Collapsed"
                Padding="6,5"
                Style="{StaticResource BarBorderStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Cỡ số bước -->
                <StackPanel x:Name="StepSizeControlsPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                    <Viewbox Style="{StaticResource IconBoxStyle}" Width="15" Height="15" Margin="4,0,0,0" TextElement.Foreground="#9AA0A6">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconStep}" />
                    </Viewbox>
                    <TextBlock Text="Cỡ số" Style="{StaticResource FlyoutLabelStyle}" ToolTip="Kích thước ô đánh số bước (Cuộn chuột để tăng/giảm)" />

                    <Button x:Name="StepSizeDecreaseButton"
                            Style="{StaticResource SpinButtonStyle}"
                            Content="−"
                            FontSize="13"
                            FontWeight="SemiBold"
                            ToolTip="Giảm cỡ số bước (Cuộn chuột xuống)"
                            Click="OnStepSizeDecreaseClick" />

                    <ComboBox x:Name="StepSizeComboBox"
                              IsEditable="True"
                              Width="60"
                              Height="26"
                              MaxDropDownHeight="180"
                              Margin="3,0"
                              Padding="4,2"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center"
                              ToolTip="Nhập cỡ số trực tiếp hoặc chọn mức gợi ý (Cuộn chuột để tăng/giảm)"
                              PreviewMouseWheel="OnStepSizeMouseWheel"
                              SelectionChanged="OnStepSizeSelectionChanged">
                        <ComboBoxItem Content="11" Tag="11" TextSearch.Text="11" ToolTip="Nhỏ (11)" />
                        <ComboBoxItem Content="14" Tag="14" TextSearch.Text="14" ToolTip="Vừa (14 - Mặc định)" IsSelected="True" />
                        <ComboBoxItem Content="18" Tag="18" TextSearch.Text="18" ToolTip="Lớn (18)" />
                        <ComboBoxItem Content="24" Tag="24" TextSearch.Text="24" ToolTip="Rất lớn (24)" />
                    </ComboBox>

                    <Button x:Name="StepSizeIncreaseButton"
                            Style="{StaticResource SpinButtonStyle}"
                            Content="+"
                            FontSize="13"
                            FontWeight="SemiBold"
                            ToolTip="Tăng cỡ số bước (Cuộn chuột lên)"
                            Click="OnStepSizeIncreaseClick" />
                </StackPanel>

                <!-- Phông & cỡ chữ -->
                <StackPanel x:Name="FontControlsPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                    <Viewbox Style="{StaticResource IconBoxStyle}" Width="15" Height="15" Margin="4,0,6,0" TextElement.Foreground="#9AA0A6"
                             ToolTip="Tùy chọn phông chữ và cỡ chữ">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconFont}" />
                    </Viewbox>
                    <ComboBox x:Name="FontFamilyComboBox"
                              Width="112"
                              Height="26"
                              MaxDropDownHeight="180"
                              Margin="2,0"
                              Padding="4,2"
                              VerticalContentAlignment="Center"
                              ToolTip="Chọn phông chữ"
                              SelectionChanged="OnFontFamilySelectionChanged">
                        <ComboBoxItem Content="Segoe UI" IsSelected="True" />
                        <ComboBoxItem Content="Arial" />
                        <ComboBoxItem Content="Calibri" />
                        <ComboBoxItem Content="Consolas" />
                        <ComboBoxItem Content="Times New Roman" />
                        <ComboBoxItem Content="Verdana" />
                        <ComboBoxItem Content="Tahoma" />
                        <ComboBoxItem Content="Courier New" />
                    </ComboBox>

                    <Button x:Name="FontSizeDecreaseButton"
                            Style="{StaticResource SpinButtonStyle}"
                            Content="−"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="6,0,0,0"
                            ToolTip="Giảm cỡ chữ (Cuộn chuột xuống)"
                            Click="OnFontSizeDecreaseClick" />

                    <ComboBox x:Name="FontSizeComboBox"
                              IsEditable="True"
                              Width="56"
                              Height="26"
                              MaxDropDownHeight="180"
                              Margin="3,0"
                              Padding="4,2"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center"
                              ToolTip="Nhập cỡ chữ trực tiếp hoặc chọn mức gợi ý (Cuộn chuột để tăng/giảm)"
                              PreviewMouseWheel="OnFontSizeMouseWheel"
                              SelectionChanged="OnFontSizeSelectionChanged">
                        <ComboBoxItem Content="12" />
                        <ComboBoxItem Content="14" />
                        <ComboBoxItem Content="16" IsSelected="True" />
                        <ComboBoxItem Content="18" />
                        <ComboBoxItem Content="20" />
                        <ComboBoxItem Content="24" />
                        <ComboBoxItem Content="28" />
                        <ComboBoxItem Content="32" />
                        <ComboBoxItem Content="40" />
                        <ComboBoxItem Content="48" />
                    </ComboBox>

                    <Button x:Name="FontSizeIncreaseButton"
                            Style="{StaticResource SpinButtonStyle}"
                            Content="+"
                            FontSize="13"
                            FontWeight="SemiBold"
                            ToolTip="Tăng cỡ chữ (Cuộn chuột lên)"
                            Click="OnFontSizeIncreaseClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. THANH NGANG TÁC VỤ -->
        <Border x:Name="HorizontalBar"
                Padding="4"
                Style="{StaticResource BarBorderStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PinButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Ghim ảnh nổi trên màn hình"
                        Click="OnPinClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconPin}" /></Viewbox>
                </Button>

                <!-- Trích xuất chữ: giữ nhãn chữ thân thiện theo yêu cầu UX -->
                <Button x:Name="OcrButton" Style="{StaticResource TextActionButtonStyle}"
                        ToolTip="Trích xuất chữ từ ảnh vào Clipboard (Ctrl + O)"
                        Click="OnOcrClick">
                    <TextBlock Text="Trích xuất chữ" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </Button>

                <Border Style="{StaticResource BarSeparatorV}" />

                <!-- Làm đẹp ảnh -->
                <Viewbox Style="{StaticResource IconBoxStyle}" Width="15" Height="15" Margin="4,0,2,0" TextElement.Foreground="#9AA0A6"
                         ToolTip="Làm đẹp ảnh: đổ bóng, bo góc &amp; nền gradient">
                    <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconSparkle}" />
                </Viewbox>
                <ComboBox x:Name="BeautifyComboBox"
                          Style="{StaticResource BarComboBoxStyle}"
                          ToolTip="Làm đẹp ảnh: đổ bóng, bo góc &amp; nền gradient"
                          Margin="2,0"
                          SelectionChanged="OnBeautifySelectionChanged">
                    <ComboBoxItem Content="Gốc" Tag="None" IsSelected="True" />
                    <ComboBoxItem Content="Sunset" Tag="Sunset" />
                    <ComboBoxItem Content="Ocean" Tag="Ocean" />
                    <ComboBoxItem Content="Purple" Tag="Purple" />
                    <ComboBoxItem Content="Dark Slate" Tag="DarkSlate" />
                </ComboBox>

                <!-- Nút ẩn BeautifyButton phục vụ API và kiểm thử -->
                <Button x:Name="BeautifyButton" Visibility="Collapsed" Click="OnBeautifyButtonClick" />

                <Border Style="{StaticResource BarSeparatorV}" />

                <Button x:Name="SaveButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Lưu file PNG (Ctrl + S)"
                        Click="OnSaveClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconSave}" /></Viewbox>
                </Button>

                <Button x:Name="CopyButton" Style="{StaticResource PrimaryActionButtonStyle}"
                        ToolTip="Sao chép vào Clipboard (Enter)"
                        Click="OnCopyClick">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource IconBoxStyle}" Width="16" Height="16"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconCopy}" /></Viewbox>
                        <TextBlock Text="Sao chép" FontWeight="SemiBold" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="CloseButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Đóng (Esc)"
                        Click="OnCloseClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}" Width="15" Height="15"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconClose}" /></Viewbox>
                </Button>
            </StackPanel>
        </Border>

    </Canvas>
</UserControl>
