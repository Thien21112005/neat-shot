<UserControl x:Class="NeatShot.Presentation.Controls.AnnotationToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">

    <Border Background="#E6242424"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6,4"
            Effect="{DynamicResource {x:Static SystemParameters.DropShadow}}">

        <StackPanel Orientation="Horizontal">
            <!-- Tay cầm kéo di chuyển thanh công cụ tự do (Drag Grip) -->
            <Border x:Name="DragGrip"
                    Cursor="SizeAll"
                    Background="Transparent"
                    Padding="3,0,5,0"
                    VerticalAlignment="Center"
                    ToolTip="Bấm giữ để di chuyển thanh công cụ tự do (Nháy đúp để tự động căn lại vị trí)"
                    MouseLeftButtonDown="OnDragGripMouseDown"
                    MouseMove="OnDragGripMouseMove"
                    MouseLeftButtonUp="OnDragGripMouseUp">
                <TextBlock Text="⋮⋮"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#80FFFFFF" />
            </Border>

            <!-- Nút Chọn & Di chuyển (Select) -->
            <Button x:Name="SelectButton"
                    ToolTip="Chọn &amp; di chuyển hình vẽ (Click chuột phải để di chuyển khung chụp)"
                    Margin="2,0"
                    Padding="6,4"
                    Click="OnSelectClick">
                <TextBlock Text="👆" FontSize="13" />
            </Button>

            <!-- Nút Bút chì (Pencil) -->
            <Button x:Name="PencilButton"
                    ToolTip="Bút vẽ tự do (P)"
                    Margin="2,0"
                    Padding="6,4"
                    Click="OnPencilClick">
                <TextBlock Text="✏️" FontSize="13" />
            </Button>

            <!-- Nút Khung chữ nhật (Rectangle) -->
            <Button x:Name="RectButton"
                    ToolTip="Vẽ khung chữ nhật (R)"
                    Margin="2,0"
                    Padding="6,4"
                    Click="OnRectClick">
                <TextBlock Text="🔲" FontSize="13" />
            </Button>

            <!-- Nút Hình Oval (Ellipse) -->
            <Button x:Name="EllipseButton"
                    ToolTip="Vẽ hình oval / elip (O)"
                    Margin="2,0"
                    Padding="6,4"
                    Click="OnEllipseClick">
                <TextBlock Text="⬭" FontSize="14" FontWeight="Bold" />
            </Button>

            <!-- Nút Đường thẳng (Line) -->
            <Button x:Name="LineButton"
                    ToolTip="Vẽ đường thẳng (L)"
                    Margin="2,0"
                    Padding="6,4"
                    Click="OnLineClick">
                <TextBlock Text="―" FontSize="13" FontWeight="Bold" />
            </Button>

            <!-- Nút Mũi tên (Arrow) -->
            <Button x:Name="ArrowButton"
                    ToolTip="Vẽ mũi tên chỉ dẫn (A)"
                    Margin="2,0"
                    Padding="6,4"
                    Click="OnArrowClick">
                <TextBlock Text="↗" FontSize="14" FontWeight="Bold" />
            </Button>

            <!-- Nút Bút dạ quang (Highlight) -->
            <Button x:Name="HighlightButton"
                    ToolTip="Bút dạ quang highlight (H)"
                    Margin="2,0"
                    Padding="6,4"
                    Click="OnHighlightClick">
                <TextBlock Text="🖍️" FontSize="13" />
            </Button>

            <!-- Nút Chèn văn bản (Text) -->
            <Button x:Name="TextButton"
                    ToolTip="Chèn chữ văn bản (T)"
                    Margin="2,0"
                    Padding="6,4"
                    Click="OnTextClick">
                <TextBlock Text="T" FontSize="13" FontWeight="Bold" />
            </Button>

            <!-- Nút Cây bút hút màu (Eyedropper) -->
            <Button x:Name="EyedropperButton"
                    ToolTip="Cây bút hút màu màn hình (I)"
                    Margin="2,0"
                    Padding="6,4"
                    Click="OnEyedropperClick">
                <TextBlock Text="💉" FontSize="13" />
            </Button>

            <Separator Margin="4,2" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

            <!-- Bảng màu mặc định -->
            <Button x:Name="ColorRedButton" ToolTip="Màu đỏ" Margin="2,0" Padding="2" Click="OnColorSelect" Tag="#FFE81123">
                <Border Width="14" Height="14" CornerRadius="7" Background="#FFE81123" />
            </Button>
            <Button x:Name="ColorYellowButton" ToolTip="Màu vàng" Margin="2,0" Padding="2" Click="OnColorSelect" Tag="#FFFFB900">
                <Border Width="14" Height="14" CornerRadius="7" Background="#FFFFB900" />
            </Button>
            <Button x:Name="ColorGreenButton" ToolTip="Màu xanh lá" Margin="2,0" Padding="2" Click="OnColorSelect" Tag="#FF107C41">
                <Border Width="14" Height="14" CornerRadius="7" Background="#FF107C41" />
            </Button>
            <Button x:Name="ColorBlueButton" ToolTip="Màu xanh dương" Margin="2,0" Padding="2" Click="OnColorSelect" Tag="#FF0078D4">
                <Border Width="14" Height="14" CornerRadius="7" Background="#FF0078D4" />
            </Button>
            <Button x:Name="ColorWhiteButton" ToolTip="Màu trắng" Margin="2,0" Padding="2" Click="OnColorSelect" Tag="#FFFFFFFF">
                <Border Width="14" Height="14" CornerRadius="7" Background="#FFFFFFFF" />
            </Button>

            <!-- Lịch sử các màu đã chọn/hút gần đây (Color History) -->
            <StackPanel x:Name="HistoryColorsPanel" Orientation="Horizontal" />

            <Separator Margin="4,2" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

            <!-- Nút Hoàn tác (Undo) -->
            <Button x:Name="UndoButton"
                    ToolTip="Hoàn tác nét vẽ (Ctrl + Z)"
                    Margin="2,0"
                    Padding="6,4"
                    Click="OnUndoClick">
                <TextBlock Text="↩" FontSize="14" FontWeight="Bold" />
            </Button>

            <!-- Nút Làm lại (Redo) -->
            <Button x:Name="RedoButton"
                    ToolTip="Làm lại nét vẽ (Ctrl + Y)"
                    Margin="2,0"
                    Padding="6,4"
                    Click="OnRedoClick">
                <TextBlock Text="↪" FontSize="14" FontWeight="Bold" />
            </Button>

            <Separator Margin="4,2" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

            <!-- Nút Copy vào Clipboard -->
            <Button x:Name="CopyButton"
                    ToolTip="Sao chép vào Clipboard (Enter)"
                    Background="#FF0078D4"
                    Foreground="White"
                    Margin="2,0"
                    Padding="8,4"
                    Click="OnCopyClick">
                <TextBlock Text="Sao chép" FontWeight="SemiBold" FontSize="12" />
            </Button>

            <!-- Nút Lưu file ảnh -->
            <Button x:Name="SaveButton"
                    ToolTip="Lưu file ảnh PNG (Ctrl + S)"
                    Margin="2,0"
                    Padding="8,4"
                    Click="OnSaveClick">
                <TextBlock Text="Lưu" FontSize="12" />
            </Button>

            <!-- Nút Hủy / Đóng -->
            <Button x:Name="CloseButton"
                    ToolTip="Đóng (Esc)"
                    Margin="2,0"
                    Padding="6,4"
                    Click="OnCloseClick">
                <TextBlock Text="✕" FontSize="12" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
