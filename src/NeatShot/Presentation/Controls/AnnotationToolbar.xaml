<UserControl x:Class="NeatShot.Presentation.Controls.AnnotationToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NeatShot.Common.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{x:Null}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/NeatShot;component/Presentation/Themes/ToolbarStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>


            <!-- Nút tác vụ chính (Sao chép): nền xanh, icon + chữ -->
            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                <Setter Property="Width" Value="NaN" />
                <Setter Property="Padding" Value="10,0,12,0" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            </Style>

            <!-- Nút tác vụ có chữ (Trích xuất chữ): viền mảnh + nền nhạt để thành một nút rõ ràng -->
            <Style x:Key="TextActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                <Setter Property="Width" Value="NaN" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="9,0,11,0" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="Foreground" Value="#E8EAED" />
                <Setter Property="Background" Value="#14FFFFFF" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>


            <!-- ============ Dropdown Hình khối / Đường kẻ ============ -->
            <Style x:Key="ToolComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder"
                                    CornerRadius="5"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Template chung: nút 32×30 hiển thị icon của lựa chọn hiện tại + mũi tên nhỏ ở góc -->
            <ControlTemplate x:Key="ToolDropdownTemplate" TargetType="ComboBox">
                <Grid Width="32" Height="30" HorizontalAlignment="Center">
                    <ToggleButton x:Name="ToggleButton"
                                  Width="32"
                                  Height="30"
                                  Focusable="False"
                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press"
                                  Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Grid Width="32" Height="30">
                                    <Border CornerRadius="5"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            SnapsToDevicePixels="True" />
                                    <Border x:Name="Overlay" CornerRadius="5" Background="{StaticResource HoverOverlayBrush}" Opacity="0" />
                                    <Viewbox Style="{StaticResource IconBoxStyle}">
                                        <Path x:Name="Glyph"
                                              Style="{StaticResource IconPathStyle}"
                                              Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                    </Viewbox>
                                    <Path HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,3,3"
                                          Data="{StaticResource IconCaret}"
                                          Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                          Opacity="0.7" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                        <Setter TargetName="Overlay" Property="Background" Value="{StaticResource PressedOverlayBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Popup x:Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           StaysOpen="False"
                           Placement="Right"
                           HorizontalOffset="6"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                        <Border Style="{StaticResource BarBorderStyle}" Padding="4" MinWidth="160" Margin="0,0,12,12">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="HasItems" Value="False">
                        <Setter TargetName="PART_Popup" Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="ToolDropdownStyle" TargetType="ComboBox">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource ToolComboBoxItemStyle}" />
                <Setter Property="Template" Value="{StaticResource ToolDropdownTemplate}" />
            </Style>

            <!-- Icon trong nút dropdown đổi theo lựa chọn (Tag mang Geometry của icon) -->
            <Style x:Key="ShapeComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ToolDropdownStyle}">
                <Setter Property="Tag" Value="{StaticResource IconRect}" />
                <Style.Triggers>
                    <Trigger Property="SelectedIndex" Value="1">
                        <Setter Property="Tag" Value="{StaticResource IconEllipse}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LineComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ToolDropdownStyle}">
                <Setter Property="Tag" Value="{StaticResource IconArrow}" />
                <Style.Triggers>
                    <Trigger Property="SelectedIndex" Value="1">
                        <Setter Property="Tag" Value="{StaticResource IconLine}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ============ Ô chọn Làm đẹp (Beautify) ============ -->
            <!-- Gradient xem trước của từng preset — trùng với BeautifyOptions.CreateBackgroundBrush -->
            <LinearGradientBrush x:Key="BeautifySwatchSunset" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FA709A" Offset="0" />
                <GradientStop Color="#FEE140" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BeautifySwatchOcean" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0093E9" Offset="0" />
                <GradientStop Color="#80D0C7" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BeautifySwatchPurple" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#667EEA" Offset="0" />
                <GradientStop Color="#764BA2" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BeautifySwatchDarkSlate" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E293B" Offset="0" />
                <GradientStop Color="#0F172A" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SparkleBrush" Color="#FFD27A" />

            <!-- Một dòng trong danh sách preset: ô màu xem trước + tên + dấu ✓ khi đang chọn -->
            <Style x:Key="BeautifyItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#E8EAED" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder" CornerRadius="6" Background="Transparent" Padding="8,7,10,7" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                                        <Border x:Name="Swatch" CornerRadius="5" BorderBrush="#33FFFFFF" BorderThickness="1" Background="Transparent" />
                                        <!-- Preset "Gốc": khung rỗng có vạch chéo -->
                                        <Path x:Name="NoneMark" Data="M5,15 L15,5" Stroke="#7D838B" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                    </Grid>
                                    <ContentPresenter Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center" />
                                    <Viewbox x:Name="Check" Grid.Column="2" Width="14" Height="14" Visibility="Hidden" TextElement.Foreground="#3B9BEB">
                                        <Path Style="{StaticResource IconPathStyle}" StrokeThickness="2.5" Data="M5,12.5 L9.5,17 L19,7.5" />
                                    </Viewbox>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="None">
                                    <Setter TargetName="Swatch" Property="BorderBrush" Value="#55FFFFFF" />
                                    <Setter TargetName="NoneMark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="Tag" Value="Sunset">
                                    <Setter TargetName="Swatch" Property="Background" Value="{StaticResource BeautifySwatchSunset}" />
                                </Trigger>
                                <Trigger Property="Tag" Value="Ocean">
                                    <Setter TargetName="Swatch" Property="Background" Value="{StaticResource BeautifySwatchOcean}" />
                                </Trigger>
                                <Trigger Property="Tag" Value="Purple">
                                    <Setter TargetName="Swatch" Property="Background" Value="{StaticResource BeautifySwatchPurple}" />
                                </Trigger>
                                <Trigger Property="Tag" Value="DarkSlate">
                                    <Setter TargetName="Swatch" Property="Background" Value="{StaticResource BeautifySwatchDarkSlate}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#260078D4" />
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Nút chọn: [✦ hoặc ô màu preset] Làm đẹp · <preset> ⌄ — danh sách xổ lên phía trên -->
            <Style x:Key="BeautifySelectorStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="30" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#E8EAED" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource BeautifyItemStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <!-- Style={x:Null} + Stretch: không để style ToggleButton của theme WPF-UI
                                     thu nhỏ vùng bấm (trước đây chỉ còn ~2px nên ô chọn như bị vô hiệu hoá) -->
                                <ToggleButton x:Name="ToggleButton"
                                              Style="{x:Null}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              MinWidth="0"
                                              Margin="0"
                                              Padding="0"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <Border x:Name="Frame" CornerRadius="6" Background="#14FFFFFF" BorderBrush="#29FFFFFF" BorderThickness="1" SnapsToDevicePixels="True" />
                                                <Border x:Name="Overlay" CornerRadius="6" Background="{StaticResource HoverOverlayBrush}" Opacity="0" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="#4DFFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <StackPanel Orientation="Horizontal" Margin="8,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <Viewbox x:Name="SparkleIcon" Visibility="Collapsed" TextElement.Foreground="{StaticResource SparkleBrush}">
                                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconSparkle}" />
                                        </Viewbox>
                                        <Border x:Name="SelectedSwatch" CornerRadius="4" BorderBrush="#40FFFFFF" BorderThickness="1"
                                                Background="{TemplateBinding Tag}" />
                                    </Grid>
                                    <TextBlock Text="{l:T Toolbar.Beautify}" Margin="8,0,0,0" Foreground="#9AA0A6" VerticalAlignment="Center" />
                                    <TextBlock Text="·" Margin="6,0" Foreground="#5F6670" VerticalAlignment="Center" />
                                    <ContentPresenter VerticalAlignment="Center"
                                                      TextElement.FontWeight="SemiBold"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                    <Path x:Name="Chevron"
                                          Margin="10,1,0,0"
                                          VerticalAlignment="Center"
                                          Data="M0,0 L4,4 L8,0"
                                          Stroke="#C9CDD2"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          RenderTransformOrigin="0.5,0.5" />
                                </StackPanel>

                                <Popup x:Name="PART_Popup"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       StaysOpen="False"
                                       Placement="Top"
                                       VerticalOffset="-4"
                                       HorizontalOffset="-12"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border Style="{StaticResource BarBorderStyle}" Padding="6" Margin="12,12,12,4" MinWidth="210">
                                        <StackPanel>
                                            <TextBlock Text="{l:T Toolbar.BeautifyHeader}" Margin="8,4,8,2" FontFamily="Consolas" FontSize="10" Foreground="#7D838B" />
                                            <TextBlock Text="{l:T Toolbar.BeautifySub}" Margin="8,0,8,6" FontSize="11" Foreground="#9AA0A6" />
                                            <Border Height="1" Margin="4,0,4,4" Background="{StaticResource SeparatorBrush}" />
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Chưa chọn preset ("Gốc"): hiện icon ✦; đã chọn: hiện ô màu gradient của preset -->
                                <Trigger Property="Tag" Value="{x:Null}">
                                    <Setter TargetName="SparkleIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="SelectedSwatch" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Nút chọn màu: chấm tròn, màu đang chọn có vòng trắng ============ -->
            <Style x:Key="ColorButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="32" Height="26">
                                <Border x:Name="Overlay" CornerRadius="5" Background="{StaticResource HoverOverlayBrush}" Opacity="0" />
                                <Border Width="22" Height="22"
                                        CornerRadius="11"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        SnapsToDevicePixels="True" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Nút tăng/giảm cỡ số & cỡ chữ ============ -->
            <Style x:Key="SpinButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
                <Setter Property="Background" Value="#14FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource BarBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SpinBorder"
                                    CornerRadius="5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SpinBorder" Property="Background" Value="#2EFFFFFF" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="SpinBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="SpinBorder" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FlyoutLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#9AA0A6" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="4,0,6,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Canvas chứa 2 thanh công cụ (thanh dọc: công cụ vẽ · thanh ngang: tác vụ) -->
    <Canvas x:Name="ToolbarCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <!-- 1. THANH DỌC CÔNG CỤ VẼ & CHÚ THÍCH -->
        <Border x:Name="VerticalBar"
                Width="42"
                Padding="4,4"
                Style="{StaticResource BarBorderStyle}">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <!-- Tay cầm kéo di chuyển thanh công cụ -->
                <Border x:Name="DragGrip"
                        Width="32"
                        Height="14"
                        Cursor="SizeAll"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        ToolTip="{l:T Toolbar.GripTip}"
                        MouseLeftButtonDown="OnDragGripMouseDown"
                        MouseMove="OnDragGripMouseMove"
                        MouseLeftButtonUp="OnDragGripMouseUp">
                    <Viewbox Width="18" Height="12" TextElement.Foreground="#66FFFFFF">
                        <Path Style="{StaticResource IconPathStyle}" StrokeThickness="2.6" Data="{StaticResource IconGrip}" />
                    </Viewbox>
                </Border>

                <Button x:Name="SelectButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="{l:T Toolbar.SelectTip}"
                        Click="OnSelectClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconSelect}" /></Viewbox>
                </Button>

                <Button x:Name="PencilButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="{l:T Toolbar.PencilTip}"
                        Click="OnPencilClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconPencil}" /></Viewbox>
                </Button>

                <!-- Dropdown Hình khối: Chữ nhật / Oval (chuột phải để đổi) -->
                <ComboBox x:Name="ShapeComboBox"
                          Width="32"
                          Height="30"
                          Style="{StaticResource ShapeComboBoxStyle}"
                          ToolTip="{l:T Toolbar.ShapeTip}"
                          PreviewMouseDown="OnShapeComboBoxPreviewMouseDown"
                          SelectionChanged="OnShapeComboBoxSelectionChanged"
                          DropDownOpened="OnShapeComboBoxDropDownOpened">
                    <ComboBoxItem Tag="Rectangle" IsSelected="True" ToolTip="{l:T Toolbar.RectTip}"
                                  PreviewMouseLeftButtonUp="OnShapeItemPreviewMouseUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Style="{StaticResource IconBoxStyle}" Width="16" Height="16"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconRect}" /></Viewbox>
                            <TextBlock Text="{l:T Toolbar.Rect}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Ellipse" ToolTip="{l:T Toolbar.EllipseTip}"
                                  PreviewMouseLeftButtonUp="OnShapeItemPreviewMouseUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Style="{StaticResource IconBoxStyle}" Width="16" Height="16"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconEllipse}" /></Viewbox>
                            <TextBlock Text="{l:T Toolbar.Ellipse}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <!-- Dropdown Đường kẻ: Mũi tên / Đường thẳng (chuột phải để đổi) -->
                <ComboBox x:Name="LineComboBox"
                          Width="32"
                          Height="30"
                          Style="{StaticResource LineComboBoxStyle}"
                          ToolTip="{l:T Toolbar.LineGroupTip}"
                          PreviewMouseDown="OnLineComboBoxPreviewMouseDown"
                          SelectionChanged="OnLineComboBoxSelectionChanged"
                          DropDownOpened="OnLineComboBoxDropDownOpened">
                    <ComboBoxItem Tag="Arrow" IsSelected="True" ToolTip="{l:T Toolbar.Arrow}"
                                  PreviewMouseLeftButtonUp="OnLineItemPreviewMouseUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Style="{StaticResource IconBoxStyle}" Width="16" Height="16"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconArrow}" /></Viewbox>
                            <TextBlock Text="{l:T Toolbar.Arrow}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Line" ToolTip="{l:T Toolbar.Line}"
                                  PreviewMouseLeftButtonUp="OnLineItemPreviewMouseUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Style="{StaticResource IconBoxStyle}" Width="16" Height="16"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconLine}" /></Viewbox>
                            <TextBlock Text="{l:T Toolbar.Line}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <!-- Các nút ẩn giữ tương thích API và kiểm thử tự động -->
                <Button x:Name="RectButton" Visibility="Collapsed" Click="OnRectClick" />
                <Button x:Name="EllipseButton" Visibility="Collapsed" Click="OnEllipseClick" />
                <Button x:Name="LineButton" Visibility="Collapsed" Click="OnLineClick" />
                <Button x:Name="ArrowButton" Visibility="Collapsed" Click="OnArrowClick" />

                <Button x:Name="HighlightButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="{l:T Toolbar.HighlightTip}"
                        Click="OnHighlightClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconHighlighter}" /></Viewbox>
                </Button>

                <Button x:Name="TextButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="{l:T Toolbar.TextTip}"
                        Click="OnTextClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconText}" /></Viewbox>
                </Button>

                <Button x:Name="StepCounterButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="{l:T Toolbar.StepTip}"
                        Click="OnStepCounterClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconStep}" /></Viewbox>
                </Button>

                <Button x:Name="PixelateButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="{l:T Toolbar.PixelateTip}"
                        Click="OnPixelateClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconPixelate}" /></Viewbox>
                </Button>

                <Button x:Name="BlurButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="{l:T Toolbar.BlurTip}"
                        Click="OnBlurClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconBlur}" /></Viewbox>
                </Button>

                <!-- Nhóm màu & hút màu (chỉ hiện khi công cụ đang dùng màu) -->
                <StackPanel x:Name="ColorPalettePanel" Orientation="Vertical" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Border Style="{StaticResource BarSeparatorH}" />

                    <Button x:Name="EyedropperButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                            ToolTip="{l:T Toolbar.DropperTip}"
                            Click="OnEyedropperClick">
                        <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconDropper}" /></Viewbox>
                    </Button>

                    <Button x:Name="ColorRedButton" Style="{StaticResource ColorButtonStyle}" ToolTip="{l:T Color.Red}" Click="OnColorSelect" Tag="#FFE81123">
                        <Ellipse Width="14" Height="14" Fill="#FFE81123" />
                    </Button>
                    <Button x:Name="ColorYellowButton" Style="{StaticResource ColorButtonStyle}" ToolTip="{l:T Color.Yellow}" Click="OnColorSelect" Tag="#FFFFB900">
                        <Ellipse Width="14" Height="14" Fill="#FFFFB900" />
                    </Button>
                    <Button x:Name="ColorGreenButton" Style="{StaticResource ColorButtonStyle}" ToolTip="{l:T Color.Green}" Click="OnColorSelect" Tag="#FF107C41">
                        <Ellipse Width="14" Height="14" Fill="#FF107C41" />
                    </Button>
                    <Button x:Name="ColorBlueButton" Style="{StaticResource ColorButtonStyle}" ToolTip="{l:T Color.Blue}" Click="OnColorSelect" Tag="#FF0078D4">
                        <Ellipse Width="14" Height="14" Fill="#FF0078D4" />
                    </Button>
                    <Button x:Name="ColorWhiteButton" Style="{StaticResource ColorButtonStyle}" ToolTip="{l:T Color.White}" Click="OnColorSelect" Tag="#FFFFFFFF">
                        <Ellipse Width="14" Height="14" Fill="#FFFFFFFF" />
                    </Button>

                    <!-- Lịch sử màu gần đây -->
                    <StackPanel x:Name="HistoryColorsPanel" Orientation="Vertical" Margin="0,2" HorizontalAlignment="Center" />
                </StackPanel>

                <Border Style="{StaticResource BarSeparatorH}" />

                <Button x:Name="UndoButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="{l:T Common.Undo}"
                        Click="OnUndoClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconUndo}" /></Viewbox>
                </Button>

                <Button x:Name="RedoButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="{l:T Common.Redo}"
                        Click="OnRedoClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconRedo}" /></Viewbox>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. FLYOUT TUỲ CHỌN (cỡ số bước / phông & cỡ chữ) -->
        <Border x:Name="FlyoutOptionsPanel"
                Visibility="Collapsed"
                Padding="6,5"
                Style="{StaticResource BarBorderStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Cỡ số bước -->
                <StackPanel x:Name="StepSizeControlsPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                    <Viewbox Style="{StaticResource IconBoxStyle}" Width="15" Height="15" Margin="4,0,0,0" TextElement.Foreground="#9AA0A6">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconStep}" />
                    </Viewbox>
                    <TextBlock Text="{l:T Toolbar.StepSize}" Style="{StaticResource FlyoutLabelStyle}" ToolTip="{l:T Toolbar.StepSizeTip}" />

                    <Button x:Name="StepSizeDecreaseButton"
                            Style="{StaticResource SpinButtonStyle}"
                            Content="−"
                            FontSize="13"
                            FontWeight="SemiBold"
                            ToolTip="{l:T Toolbar.StepSizeDownTip}"
                            Click="OnStepSizeDecreaseClick" />

                    <ComboBox x:Name="StepSizeComboBox"
                              IsEditable="True"
                              Width="60"
                              Height="26"
                              MaxDropDownHeight="180"
                              Margin="3,0"
                              Padding="4,2"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center"
                              ToolTip="{l:T Toolbar.SizeInputTip}"
                              PreviewMouseWheel="OnStepSizeMouseWheel"
                              SelectionChanged="OnStepSizeSelectionChanged">
                        <ComboBoxItem Content="11" Tag="11" TextSearch.Text="11" ToolTip="{l:T Toolbar.SizeSmall}" />
                        <ComboBoxItem Content="14" Tag="14" TextSearch.Text="14" ToolTip="{l:T Toolbar.SizeMedium}" IsSelected="True" />
                        <ComboBoxItem Content="18" Tag="18" TextSearch.Text="18" ToolTip="{l:T Toolbar.SizeLarge}" />
                        <ComboBoxItem Content="24" Tag="24" TextSearch.Text="24" ToolTip="{l:T Toolbar.SizeXLarge}" />
                    </ComboBox>

                    <Button x:Name="StepSizeIncreaseButton"
                            Style="{StaticResource SpinButtonStyle}"
                            Content="+"
                            FontSize="13"
                            FontWeight="SemiBold"
                            ToolTip="{l:T Toolbar.StepSizeUpTip}"
                            Click="OnStepSizeIncreaseClick" />
                </StackPanel>

                <!-- Phông & cỡ chữ -->
                <StackPanel x:Name="FontControlsPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                    <Viewbox Style="{StaticResource IconBoxStyle}" Width="15" Height="15" Margin="4,0,6,0" TextElement.Foreground="#9AA0A6"
                             ToolTip="{l:T Toolbar.FontOptionsTip}">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconFont}" />
                    </Viewbox>
                    <ComboBox x:Name="FontFamilyComboBox"
                              Width="112"
                              Height="26"
                              MaxDropDownHeight="180"
                              Margin="2,0"
                              Padding="4,2"
                              VerticalContentAlignment="Center"
                              ToolTip="{l:T Toolbar.FontTip}"
                              SelectionChanged="OnFontFamilySelectionChanged">
                        <ComboBoxItem Content="Segoe UI" IsSelected="True" />
                        <ComboBoxItem Content="Arial" />
                        <ComboBoxItem Content="Calibri" />
                        <ComboBoxItem Content="Consolas" />
                        <ComboBoxItem Content="Times New Roman" />
                        <ComboBoxItem Content="Verdana" />
                        <ComboBoxItem Content="Tahoma" />
                        <ComboBoxItem Content="Courier New" />
                    </ComboBox>

                    <Button x:Name="FontSizeDecreaseButton"
                            Style="{StaticResource SpinButtonStyle}"
                            Content="−"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="6,0,0,0"
                            ToolTip="{l:T Toolbar.FontSizeDownTip}"
                            Click="OnFontSizeDecreaseClick" />

                    <ComboBox x:Name="FontSizeComboBox"
                              IsEditable="True"
                              Width="56"
                              Height="26"
                              MaxDropDownHeight="180"
                              Margin="3,0"
                              Padding="4,2"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center"
                              ToolTip="{l:T Toolbar.SizeInputTip}"
                              PreviewMouseWheel="OnFontSizeMouseWheel"
                              SelectionChanged="OnFontSizeSelectionChanged">
                        <ComboBoxItem Content="12" />
                        <ComboBoxItem Content="14" />
                        <ComboBoxItem Content="16" IsSelected="True" />
                        <ComboBoxItem Content="18" />
                        <ComboBoxItem Content="20" />
                        <ComboBoxItem Content="24" />
                        <ComboBoxItem Content="28" />
                        <ComboBoxItem Content="32" />
                        <ComboBoxItem Content="40" />
                        <ComboBoxItem Content="48" />
                    </ComboBox>

                    <Button x:Name="FontSizeIncreaseButton"
                            Style="{StaticResource SpinButtonStyle}"
                            Content="+"
                            FontSize="13"
                            FontWeight="SemiBold"
                            ToolTip="{l:T Toolbar.FontSizeUpTip}"
                            Click="OnFontSizeIncreaseClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. THANH NGANG TÁC VỤ -->
        <Border x:Name="HorizontalBar"
                Padding="4"
                Style="{StaticResource BarBorderStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PinButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="{l:T Toolbar.PinTip}"
                        Click="OnPinClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconPin}" /></Viewbox>
                </Button>

                <Border Style="{StaticResource BarSeparatorV}" />

                <!-- Trích xuất chữ: nút riêng có viền + icon để không bị nhìn nhầm là nhãn của nút Ghim bên cạnh -->
                <Button x:Name="OcrButton" Style="{StaticResource TextActionButtonStyle}"
                        ToolTip="{l:T Toolbar.OcrTip}"
                        Click="OnOcrClick">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource IconBoxStyle}" Width="15" Height="15"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconOcr}" /></Viewbox>
                        <TextBlock Text="{l:T Toolbar.Ocr}" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource BarSeparatorV}" />

                <!-- Làm đẹp ảnh -->
                <ComboBox x:Name="BeautifyComboBox"
                          Style="{StaticResource BeautifySelectorStyle}"
                          ToolTip="{l:T Toolbar.BeautifyTip}"
                          Margin="2,0"
                          SelectionChanged="OnBeautifySelectionChanged">
                    <ComboBoxItem Content="{l:T Toolbar.BeautifyNone}" Tag="None" IsSelected="True" />
                    <ComboBoxItem Content="Sunset" Tag="Sunset" />
                    <ComboBoxItem Content="Ocean" Tag="Ocean" />
                    <ComboBoxItem Content="Purple" Tag="Purple" />
                    <ComboBoxItem Content="Dark Slate" Tag="DarkSlate" />
                </ComboBox>

                <!-- Nút ẩn BeautifyButton phục vụ API và kiểm thử -->
                <Button x:Name="BeautifyButton" Visibility="Collapsed" Click="OnBeautifyButtonClick" />

                <Border Style="{StaticResource BarSeparatorV}" />

                <Button x:Name="SaveButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="{l:T Toolbar.SaveTip}"
                        Click="OnSaveClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconSave}" /></Viewbox>
                </Button>

                <Button x:Name="CopyButton" Style="{StaticResource PrimaryActionButtonStyle}"
                        ToolTip="{l:T Toolbar.CopyTip}"
                        Click="OnCopyClick">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource IconBoxStyle}" Width="16" Height="16"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconCopy}" /></Viewbox>
                        <TextBlock Text="{l:T Toolbar.Copy}" FontWeight="SemiBold" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="CloseButton" Width="32" Style="{StaticResource ToolButtonStyle}"
                        ToolTip="{l:T Common.CloseEsc}"
                        Click="OnCloseClick">
                    <Viewbox Style="{StaticResource IconBoxStyle}" Width="15" Height="15"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconClose}" /></Viewbox>
                </Button>
            </StackPanel>
        </Border>

    </Canvas>
</UserControl>
