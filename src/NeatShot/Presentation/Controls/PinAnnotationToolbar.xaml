<UserControl x:Class="NeatShot.Presentation.Controls.PinAnnotationToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:NeatShot.Presentation.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Cùng bộ icon / style với thanh chú thích chính khi chụp -->
                <ResourceDictionary Source="pack://application:,,,/NeatShot;component/Presentation/Themes/ToolbarStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Ô màu tròn; màu đang dùng có vòng sáng bao quanh -->
            <Style x:Key="SwatchStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Ellipse x:Name="Ring" Width="22" Height="22" Stroke="Transparent" StrokeThickness="2" />
                                <Ellipse Width="16" Height="16" Fill="{TemplateBinding Background}" Stroke="#40FFFFFF" StrokeThickness="1" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="#66FFFFFF" />
                                </Trigger>
                                <Trigger Property="local:PinAnnotationToolbar.IsCurrent" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Margin chừa chỗ cho bóng đổ khi nằm trong Popup trong suốt -->
    <Border Style="{StaticResource BarBorderStyle}" Padding="4" Margin="10,6,10,14">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SelectButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Chọn / kéo di chuyển ảnh (V)" Click="OnSelectClick">
                <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconSelect}" /></Viewbox>
            </Button>
            <Button x:Name="PencilButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Bút vẽ" Click="OnPencilClick">
                <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconPencil}" /></Viewbox>
            </Button>
            <Button x:Name="HighlightButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Bút dạ quang (H)" Click="OnHighlightClick">
                <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconHighlighter}" /></Viewbox>
            </Button>

            <Border Style="{StaticResource BarSeparatorV}" />

            <Button x:Name="RectButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Khung chữ nhật (R)" Click="OnRectClick">
                <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconRect}" /></Viewbox>
            </Button>
            <Button x:Name="EllipseButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Hình elip (E)" Click="OnEllipseClick">
                <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconEllipse}" /></Viewbox>
            </Button>
            <Button x:Name="LineButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Đường thẳng (L)" Click="OnLineClick">
                <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconLine}" /></Viewbox>
            </Button>
            <Button x:Name="ArrowButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Mũi tên (A)" Click="OnArrowClick">
                <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconArrow}" /></Viewbox>
            </Button>
            <Button x:Name="TextButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Chữ (T)" Click="OnTextClick">
                <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconText}" /></Viewbox>
            </Button>
            <Button x:Name="StepButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Đánh số thứ tự (N)" Click="OnStepClick">
                <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconStep}" /></Viewbox>
            </Button>

            <Border Style="{StaticResource BarSeparatorV}" />

            <Button x:Name="PixelateButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Làm vỡ điểm ảnh để che thông tin (X)" Click="OnPixelateClick">
                <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconPixelate}" /></Viewbox>
            </Button>
            <Button x:Name="BlurButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Làm mờ (B)" Click="OnBlurClick">
                <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconBlur}" /></Viewbox>
            </Button>

            <Border Style="{StaticResource BarSeparatorV}" />

            <Button x:Name="ColorRedButton" Style="{StaticResource SwatchStyle}" Background="#FF3B30" ToolTip="Đỏ" Click="OnColorClick" />
            <Button x:Name="ColorYellowButton" Style="{StaticResource SwatchStyle}" Background="#FFCC00" ToolTip="Vàng" Click="OnColorClick" />
            <Button x:Name="ColorGreenButton" Style="{StaticResource SwatchStyle}" Background="#34C759" ToolTip="Xanh lá" Click="OnColorClick" />
            <Button x:Name="ColorBlueButton" Style="{StaticResource SwatchStyle}" Background="#0078D4" ToolTip="Xanh dương" Click="OnColorClick" />
            <Button x:Name="ColorWhiteButton" Style="{StaticResource SwatchStyle}" Background="#FFFFFF" ToolTip="Trắng" Click="OnColorClick" />
            <Button x:Name="ColorBlackButton" Style="{StaticResource SwatchStyle}" Background="#1B1F24" ToolTip="Đen" Click="OnColorClick" />

            <Border Style="{StaticResource BarSeparatorV}" />

            <Button x:Name="UndoButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Hoàn tác (Ctrl + Z)" Click="OnUndoClick">
                <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconUndo}" /></Viewbox>
            </Button>
            <Button x:Name="RedoButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Làm lại (Ctrl + Y)" Click="OnRedoClick">
                <Viewbox Style="{StaticResource IconBoxStyle}"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconRedo}" /></Viewbox>
            </Button>
            <Button x:Name="HideToolbarButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Ẩn thanh vẽ (Esc)" Click="OnHideClick">
                <Viewbox Style="{StaticResource IconBoxStyle}" Width="15" Height="15"><Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconClose}" /></Viewbox>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
