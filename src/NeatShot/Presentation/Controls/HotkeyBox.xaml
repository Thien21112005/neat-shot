<UserControl x:Class="NeatShot.Presentation.Controls.HotkeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Cursor="Hand"
             MinWidth="190"
             Height="34">
    <!-- Ô gán phím tắt: bấm vào rồi nhấn tổ hợp phím mới; Esc để huỷ -->
    <Border x:Name="Frame"
            CornerRadius="6"
            Background="#0E0F12"
            BorderBrush="#29FFFFFF"
            BorderThickness="1"
            Padding="10,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DisplayText"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="#E8EAED"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="EditHint"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#7D838B"
                       Text="Bấm để đổi" />
        </Grid>
    </Border>
</UserControl>
