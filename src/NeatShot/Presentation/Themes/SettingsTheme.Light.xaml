<!-- Bảng màu sáng của cửa sổ Cài đặt (cùng bộ khóa với SettingsTheme.Dark.xaml). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="StWindowBg" Color="#F5F6F8" />
    <SolidColorBrush x:Key="StWindowBorder" Color="#D3D7DC" />
    <SolidColorBrush x:Key="StDivider" Color="#E6E8EC" />
    <SolidColorBrush x:Key="StCardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StCardBorder" Color="#E1E4E8" />
    <SolidColorBrush x:Key="StText" Color="#1B1F24" />
    <SolidColorBrush x:Key="StMuted" Color="#59616B" />
    <SolidColorBrush x:Key="StSection" Color="#0067C0" />
    <SolidColorBrush x:Key="StControlBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StControlBorder" Color="#C5CAD1" />
    <SolidColorBrush x:Key="StControlHoverBg" Color="#F0F2F5" />
    <SolidColorBrush x:Key="StControlHoverBorder" Color="#9EA5AE" />
    <SolidColorBrush x:Key="StInputBg" Color="#F5F6F8" />
    <SolidColorBrush x:Key="StTrackOff" Color="#D3D7DC" />
    <SolidColorBrush x:Key="StThumbOff" Color="#59616B" />
    <SolidColorBrush x:Key="StIconHoverBg" Color="#E8EBEF" />
    <SolidColorBrush x:Key="StHeaderIconBg" Color="#1A0078D4" />
    <SolidColorBrush x:Key="StHeaderIcon" Color="#0067C0" />
    <SolidColorBrush x:Key="StAccentText" Color="#0067C0" />
    <SolidColorBrush x:Key="StSuccess" Color="#15803D" />
    <SolidColorBrush x:Key="StError" Color="#DC2626" />
    <SolidColorBrush x:Key="StWarning" Color="#B45309" />
    <Color x:Key="StShadowColor">#55000000</Color>
</ResourceDictionary>
