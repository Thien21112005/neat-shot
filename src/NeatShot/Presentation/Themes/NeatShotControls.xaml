<!-- Bộ style dùng chung của NeatShot (thẻ, nút, icon, công tắc) — đồng bộ với toolbar và landing page -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bộ icon nét mảnh (24×24) dùng chung cho thẻ kết quả trích xuất chữ -->
    <Geometry x:Key="CardIconOcr">M8,4 H5 V20 H8 M16,4 H19 V20 H16 M9,8.5 H15 M12,8.5 V16</Geometry>
    <Geometry x:Key="CardIconCopy">M10,8 H18 A2,2 0 0 1 20,10 V18 A2,2 0 0 1 18,20 H10 A2,2 0 0 1 8,18 V10 A2,2 0 0 1 10,8 Z M16,8 V6 A2,2 0 0 0 14,4 H6 A2,2 0 0 0 4,6 V14 A2,2 0 0 0 6,16 H8</Geometry>
    <Geometry x:Key="CardIconPencil">M4,20 L5,16 L16,5 L19,8 L8,19 Z M14,7 L17,10</Geometry>
    <Geometry x:Key="CardIconCheck">M5,12.5 L9.5,17 L19,7.5</Geometry>
    <Geometry x:Key="CardIconCheckCircle">M3.5,12 A8.5,8.5 0 1 0 20.5,12 A8.5,8.5 0 1 0 3.5,12 Z M8.5,12.3 L11,14.8 L15.8,9.6</Geometry>
    <Geometry x:Key="CardIconClose">M6,6 L18,18 M18,6 L6,18</Geometry>

    <Style x:Key="CardIconPath" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.9" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- Nút phụ: viền mảnh, nền tối -->
    <Style x:Key="CardGhostButton" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#E8EAED" />
        <Setter Property="Background" Value="#0FFFFFFF" />
        <Setter Property="BorderBrush" Value="#29FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#4DFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút chính: nền xanh -->
    <Style x:Key="CardPrimaryButton" TargetType="Button" BasedOn="{StaticResource CardGhostButton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#0078D4" />
        <Setter Property="BorderBrush" Value="#0078D4" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A86DC" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#006CBE" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút icon tròn nhỏ (đóng thẻ) -->
    <Style x:Key="CardIconButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#9AA0A6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ô văn bản kết quả: nền tối, font monospace, không phụ thuộc theme -->
    <Style x:Key="CardTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="#E8EAED" />
        <Setter Property="Background" Value="#0E0F12" />
        <Setter Property="BorderBrush" Value="#1FFFFFFF" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="SelectionBrush" Value="#0078D4" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#660078D4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Bổ sung cho cửa sổ Cài đặt ============ -->
    <Geometry x:Key="CardIconGear">M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9 Z M19.4,13.5 A7.6,7.6 0 0 0 19.4,10.5 L21.4,9 L19.4,5.5 L17,6.4 A7.6,7.6 0 0 0 14.4,4.9 L14,2.5 H10 L9.6,4.9 A7.6,7.6 0 0 0 7,6.4 L4.6,5.5 L2.6,9 L4.6,10.5 A7.6,7.6 0 0 0 4.6,13.5 L2.6,15 L4.6,18.5 L7,17.6 A7.6,7.6 0 0 0 9.6,19.1 L10,21.5 H14 L14.4,19.1 A7.6,7.6 0 0 0 17,17.6 L19.4,18.5 L21.4,15 Z</Geometry>
    <Geometry x:Key="CardIconKeyboard">M4,6 H20 A1.5,1.5 0 0 1 21.5,7.5 V16.5 A1.5,1.5 0 0 1 20,18 H4 A1.5,1.5 0 0 1 2.5,16.5 V7.5 A1.5,1.5 0 0 1 4,6 Z M6.5,10 h0.01 M10,10 h0.01 M13.5,10 h0.01 M17,10 h0.01 M8,14 H16</Geometry>
    <Geometry x:Key="CardIconFolder">M3.5,7 A1.5,1.5 0 0 1 5,5.5 H9.5 L11.5,7.5 H19 A1.5,1.5 0 0 1 20.5,9 V17 A1.5,1.5 0 0 1 19,18.5 H5 A1.5,1.5 0 0 1 3.5,17 Z</Geometry>
    <Geometry x:Key="CardIconSliders">M4,7 H14 M18,7 H20 M4,17 H8 M12,17 H20 M14,4.5 V9.5 M10,14.5 V19.5</Geometry>
    <Geometry x:Key="CardIconReset">M4.5,12 A7.5,7.5 0 1 0 7,6.4 M4,4 V8.5 H8.5</Geometry>

    <SolidColorBrush x:Key="NsSurface" Color="#16181D" />
    <SolidColorBrush x:Key="NsSurface2" Color="#1E2128" />
    <SolidColorBrush x:Key="NsBorder" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="NsText" Color="#E8EAED" />
    <SolidColorBrush x:Key="NsMuted" Color="#9AA0A6" />
    <SolidColorBrush x:Key="NsAccent" Color="#0078D4" />

    <!-- Nhóm cài đặt dạng thẻ -->
    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="#0E0F12" />
        <Setter Property="BorderBrush" Value="{StaticResource NsBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,4" />
    </Style>

    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#3B9BEB" />
        <Setter Property="Margin" Value="2,18,0,8" />
    </Style>

    <Style x:Key="SettingsLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource NsText}" />
    </Style>

    <Style x:Key="SettingsHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource NsMuted}" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Công tắc bật/tắt (CheckBox dạng pill) -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="22" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="11" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" />
                        <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#C9CDD2" HorizontalAlignment="Left" Margin="4,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#0078D4" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#0078D4" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="#66FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="#3B9BEB" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lựa chọn dạng phân đoạn (PNG | JPG) -->
    <Style x:Key="SegmentRadio" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource NsMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="5" Padding="14,6" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource NsText}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0078D4" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thanh trượt gọn, tối -->
    <Style x:Key="SettingsSlider" TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="#26FFFFFF" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="#0078D4" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="14" Height="14" Fill="White" Stroke="#0078D4" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
