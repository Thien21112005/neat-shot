<!--
  Bộ icon nét mảnh và style thanh công cụ dùng chung (thanh chú thích chính và thanh vẽ trên ảnh ghim),
  đồng bộ với bộ icon SVG của landing page.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============ Bảng màu & kích thước (đồng bộ với landing page) ============ -->
    <SolidColorBrush x:Key="BarBackgroundBrush" Color="#F716181D" />
    <SolidColorBrush x:Key="BarBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="IconBrush" Color="#C9CDD2" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4" />

    <DropShadowEffect x:Key="BarShadow" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.45" Color="Black" />

    <!-- ============ Bộ icon nét mảnh (lưới 24×24, giống bộ icon SVG của landing page) ============ -->
    <Geometry x:Key="IconGrip">M6,9 h0.01 M12,9 h0.01 M18,9 h0.01 M6,15 h0.01 M12,15 h0.01 M18,15 h0.01</Geometry>
    <Geometry x:Key="IconSelect">M5,4 L18,10.5 L12.4,12.1 L10,18 Z M12.4,12.1 L17,17</Geometry>
    <Geometry x:Key="IconPencil">M4,20 L5,16 L16,5 L19,8 L8,19 Z M14,7 L17,10</Geometry>
    <Geometry x:Key="IconHighlighter">M15,4 L20,9 L12,17 H8 V13 Z M4,20 H12</Geometry>
    <Geometry x:Key="IconRect">M5.5,6 H18.5 A1.5,1.5 0 0 1 20,7.5 V16.5 A1.5,1.5 0 0 1 18.5,18 H5.5 A1.5,1.5 0 0 1 4,16.5 V7.5 A1.5,1.5 0 0 1 5.5,6 Z</Geometry>
    <Geometry x:Key="IconEllipse">M3.5,12 A8.5,6.5 0 1 0 20.5,12 A8.5,6.5 0 1 0 3.5,12 Z</Geometry>
    <Geometry x:Key="IconLine">M5,19 L19,5</Geometry>
    <Geometry x:Key="IconArrow">M5,19 L19,5 M10,5 H19 V14</Geometry>
    <Geometry x:Key="IconText">M5,6 H19 M12,6 V19 M9,19 H15</Geometry>
    <Geometry x:Key="IconStep">M3.5,12 A8.5,8.5 0 1 0 20.5,12 A8.5,8.5 0 1 0 3.5,12 Z M10.5,9.5 L12.5,8 V16</Geometry>
    <Geometry x:Key="IconPixelate">M4,4 h5 v5 H4 Z M15,4 h5 v5 h-5 Z M9.5,9.5 h5 v5 h-5 Z M4,15 h5 v5 H4 Z M15,15 h5 v5 h-5 Z</Geometry>
    <Geometry x:Key="IconBlur">M12,3.5 C15.2,7.7 18,10.8 18,14 A6,6 0 0 1 6,14 C6,10.8 8.8,7.7 12,3.5 Z M9.5,14.5 A2.5,2.5 0 0 0 12,17</Geometry>
    <Geometry x:Key="IconDropper">M16.5,4.5 A2.1,2.1 0 0 1 19.5,7.5 L17,10 L14,7 Z M14,7 L5.5,15.5 L5,19 L8.5,18.5 L17,10</Geometry>
    <Geometry x:Key="IconUndo">M9,14 L4,9 L9,4 M4,9 H14.5 A5.5,5.5 0 0 1 14.5,20 H11</Geometry>
    <Geometry x:Key="IconRedo">M15,14 L20,9 L15,4 M20,9 H9.5 A5.5,5.5 0 0 0 9.5,20 H13</Geometry>
    <Geometry x:Key="IconPin">M9,3.5 H15 M10,3.5 V9 L7,13 H17 L14,9 V3.5 M12,13 V20.5</Geometry>
    <Geometry x:Key="IconOcr">M8,4 H5 V20 H8 M16,4 H19 V20 H16 M9,8.5 H15 M12,8.5 V16</Geometry>
    <Geometry x:Key="IconSparkle">M12,3.5 L13.9,8.6 L19,10.5 L13.9,12.4 L12,17.5 L10.1,12.4 L5,10.5 L10.1,8.6 Z M18.5,15.5 L19.3,17.7 L21.5,18.5 L19.3,19.3 L18.5,21.5 L17.7,19.3 L15.5,18.5 L17.7,17.7 Z</Geometry>
    <Geometry x:Key="IconCopy">M10,8 H18 A2,2 0 0 1 20,10 V18 A2,2 0 0 1 18,20 H10 A2,2 0 0 1 8,18 V10 A2,2 0 0 1 10,8 Z M16,8 V6 A2,2 0 0 0 14,4 H6 A2,2 0 0 0 4,6 V14 A2,2 0 0 0 6,16 H8</Geometry>
    <Geometry x:Key="IconSave">M12,4 V15 M7.5,10.5 L12,15 L16.5,10.5 M5,20 H19</Geometry>
    <Geometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="IconFont">M4,19 L9.5,5 L15,19 M6.2,14 H12.8 M16,19 V11 M16,13 A3,3 0 0 1 22,13 V19</Geometry>
    <Geometry x:Key="IconCaret">M0,0 L5,0 L2.5,3 Z</Geometry>

    <!-- Path vẽ icon: nét theo màu chữ (Foreground) của nút chứa nó -->
    <Style x:Key="IconPathStyle" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="StrokeThickness" Value="1.75" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="IconBoxStyle" TargetType="Viewbox">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============ Nút công cụ: nền trong suốt, hover phủ sáng nhẹ, đang chọn = nền xanh đặc ============ -->
    <Style x:Key="ToolButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="Overlay" CornerRadius="5" Background="{StaticResource HoverOverlayBrush}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{StaticResource PressedOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vạch ngăn nhóm -->
    <Style x:Key="BarSeparatorH" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,5" />
        <Setter Property="Background" Value="{StaticResource SeparatorBrush}" />
    </Style>
    <Style x:Key="BarSeparatorV" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="Background" Value="{StaticResource SeparatorBrush}" />
    </Style>

    <!-- Khung thanh công cụ -->
    <Style x:Key="BarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Effect" Value="{StaticResource BarShadow}" />
    </Style>
</ResourceDictionary>
