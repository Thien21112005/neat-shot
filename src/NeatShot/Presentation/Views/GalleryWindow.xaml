<Window x:Class="NeatShot.Presentation.Views.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NeatShot.Presentation.ViewModels"
        xmlns:converters="clr-namespace:NeatShot.Presentation.Converters"
        mc:Ignorable="d"
        Title="Thư viện ảnh chụp NeatShot"
        Width="940"
        Height="640"
        MinWidth="680"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        Foreground="#E0E0E0"
        d:DataContext="{d:DesignInstance vm:GalleryViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:FilePathToBitmapConverter x:Key="FilePathToBitmapConverter" />

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#555555" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333337" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteActionButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Background" Value="#3F2525" />
            <Setter Property="Foreground" Value="#FF9999" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D83B01" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A80000" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0"
                Background="#202020"
                BorderBrush="#2D2D30"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖼️ Thư viện ảnh NeatShot"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
                        <Border Background="#007ACC"
                                CornerRadius="10"
                                Padding="8,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} ảnh'}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ScreenshotsDirectory}"
                               FontSize="11"
                               Foreground="#888888"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="Đường dẫn thư mục lưu ảnh" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Làm mới"
                            Command="{Binding LoadItemsCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Nạp lại danh sách ảnh từ ổ đĩa" />
                    <Button Content="📁 Mở thư mục"
                            Command="{Binding OpenFolderCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            ToolTip="Mở thư mục ảnh trong File Explorer" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="📷"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Opacity="0.6" />
                <TextBlock Text="Chưa có ảnh chụp nào trong thư mục NeatShot"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#BBBBBB"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,4" />
                <TextBlock Text="Các ảnh chụp màn hình khi lưu sẽ xuất hiện ở đây để bạn xem lại hoặc ghim lên màn hình."
                           FontSize="12"
                           Foreground="#777777"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />
                <Button Content="📁 Mở thư mục lưu trữ"
                        Command="{Binding OpenFolderCommand}"
                        Style="{StaticResource ModernButtonStyle}"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Screenshots Gallery List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12"
                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVisConverter}}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="280"
                                    Margin="8"
                                    Background="#252528"
                                    BorderBrush="#38383C"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8"
                                                      ShadowDepth="2"
                                                      Opacity="0.25"
                                                      Direction="270"
                                                      Color="Black" />
                                </Border.Effect>

                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Row="0"
                                            Background="#1A1A1A"
                                            CornerRadius="4"
                                            ClipToBounds="True">
                                        <Image Source="{Binding FilePath, Converter={StaticResource FilePathToBitmapConverter}}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <!-- File Name -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding FileName}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               Margin="0,8,0,2"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FileName}" />

                                    <!-- Metadata Info -->
                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm:ss - dd/MM/yyyy}'}"
                                                   FontSize="11"
                                                   Foreground="#8A8A8A" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding FormattedDimensions}"
                                                       FontSize="11"
                                                       Foreground="#8A8A8A" />
                                            <TextBlock Text=" • "
                                                       FontSize="11"
                                                       Foreground="#666666" />
                                            <TextBlock Text="{Binding FormattedSize}"
                                                       FontSize="11"
                                                       Foreground="#8A8A8A" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Action Buttons -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Content="📌 Ghim lên màn hình"
                                                Style="{StaticResource CardActionButtonStyle}"
                                                Command="{Binding DataContext.PinItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Ghim ảnh nổi trên màn hình như ghi chú sticky note (click vào ảnh để vẽ chú thích)" />

                                        <Button Grid.Column="1"
                                                Content="📋 Copy"
                                                Style="{StaticResource CardActionButtonStyle}"
                                                Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Sao chép ảnh vào Clipboard" />

                                        <Button Grid.Column="2"
                                                Content="🗑️"
                                                Style="{StaticResource DeleteActionButtonStyle}"
                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Xóa ảnh khỏi thư mục lưu trữ" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
