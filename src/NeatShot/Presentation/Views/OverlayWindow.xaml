<Window x:Class="NeatShot.Presentation.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NeatShot.Presentation.Controls"
        xmlns:vm="clr-namespace:NeatShot.Presentation.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:OverlayViewModel}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        KeyDown="OnWindowKeyDown"
        MouseRightButtonDown="OnWindowMouseRightButtonDown">

    <Grid>
        <!-- Ảnh màn hình đóng băng làm nền -->
        <Image Source="{Binding BackgroundImage}"
               Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- Canvas kéo chọn vùng và phủ bóng tối mờ -->
        <controls:SelectionCanvas x:Name="SelectionControl"
                                  SelectedRegion="{Binding SelectedRegion, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" />

        <!-- Lớp vẽ chú thích vector (Pencil, Rectangle, Arrow) -->
        <controls:DrawingCanvas x:Name="DrawingControl"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

        <!-- Thanh công cụ nổi cạnh vùng chọn -->
        <Canvas x:Name="OverlayCanvas">
            <controls:AnnotationToolbar x:Name="Toolbar"
                                        Visibility="Collapsed" />

            <!-- Kính lúp hiển thị màu và mã HEX khi dùng công cụ hút màu (Eyedropper) -->
            <Border x:Name="EyedropperLoupe"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Background="#E61E1E1E"
                    BorderBrush="#4DFFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6,5"
                    Effect="{DynamicResource {x:Static SystemParameters.DropShadow}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="LoupeColorSwatch"
                            Width="24"
                            Height="24"
                            CornerRadius="12"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1.5"
                            Margin="0,0,8,0"
                            Background="#FFE81123" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LoupeHexText"
                                   Text="#E81123"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="White" />
                        <TextBlock Text="Click để chọn màu"
                                   FontSize="9"
                                   Foreground="#A0FFFFFF" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
