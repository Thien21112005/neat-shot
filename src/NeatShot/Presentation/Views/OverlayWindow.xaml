<Window x:Class="NeatShot.Presentation.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NeatShot.Presentation.Controls"
        xmlns:vm="clr-namespace:NeatShot.Presentation.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:OverlayViewModel}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        KeyDown="OnWindowKeyDown"
        MouseRightButtonDown="OnWindowMouseRightButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/NeatShot;component/Presentation/Themes/NeatShotControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Ảnh màn hình đóng băng làm nền -->
        <Image Source="{Binding BackgroundImage}"
               Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- Canvas kéo chọn vùng và phủ bóng tối mờ -->
        <controls:SelectionCanvas x:Name="SelectionControl"
                                  SelectedRegion="{Binding SelectedRegion, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" />

        <!-- Lớp vẽ chú thích vector (Pencil, Rectangle, Arrow) -->
        <controls:DrawingCanvas x:Name="DrawingControl"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

        <!-- Thanh công cụ nổi cạnh vùng chọn và các lớp overlay tương tác -->
        <Canvas x:Name="OverlayCanvas">
            <!-- Gợi ý khi vừa mở màn hình chụp (ẩn khi đã có vùng chọn) -->
            <Border x:Name="SelectionHint"
                    IsHitTestVisible="False"
                    Canvas.Top="16"
                    Background="#E60E0F12"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Màn hình đã đóng băng · Kéo để chọn vùng"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="#E8EAED" />
                    <TextBlock Text="  ·  Esc để thoát"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="#9AA0A6" />
                </StackPanel>
            </Border>

            <!-- Khung xem trước hiệu ứng Làm đẹp ảnh trực tiếp (Live Beautify Preview Frame) -->
            <Border x:Name="BeautifyPreviewFrame"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                      Direction="270"
                                      ShadowDepth="8"
                                      BlurRadius="28"
                                      Opacity="0.55" />
                </Border.Effect>
                <Border x:Name="BeautifyInnerPhotoFrame"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="20"
                        CornerRadius="12"
                        BorderBrush="#4DFFFFFF"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          Direction="270"
                                          ShadowDepth="5"
                                          BlurRadius="18"
                                          Opacity="0.4" />
                    </Border.Effect>
                </Border>
            </Border>

            <!-- 8 nút điều chỉnh kích thước hiển thị trên khung Làm đẹp (Resize Handles) -->
            <Canvas x:Name="BeautifyHandlesLayer"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Rectangle x:Name="BHandleNW" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="White" Stroke="#0078D4" StrokeThickness="1.5" />
                <Rectangle x:Name="BHandleN"  Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="White" Stroke="#0078D4" StrokeThickness="1.5" />
                <Rectangle x:Name="BHandleNE" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="White" Stroke="#0078D4" StrokeThickness="1.5" />
                <Rectangle x:Name="BHandleW"  Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="White" Stroke="#0078D4" StrokeThickness="1.5" />
                <Rectangle x:Name="BHandleE"  Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="White" Stroke="#0078D4" StrokeThickness="1.5" />
                <Rectangle x:Name="BHandleSW" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="White" Stroke="#0078D4" StrokeThickness="1.5" />
                <Rectangle x:Name="BHandleS"  Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="White" Stroke="#0078D4" StrokeThickness="1.5" />
                <Rectangle x:Name="BHandleSE" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="White" Stroke="#0078D4" StrokeThickness="1.5" />
            </Canvas>

            <controls:AnnotationToolbar x:Name="Toolbar"
                                        Visibility="Collapsed" />

            <!-- Thẻ kết quả Trích xuất chữ (cùng phong cách với panel "Extracted text" trên landing page) -->
            <Border x:Name="OcrResultCard"
                    Visibility="Collapsed"
                    Width="580"
                    Background="#F716181D"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="12" Direction="270" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header: icon + tiêu đề + nhãn offline + nút đóng -->
                    <Border Padding="16,12,10,12" BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="7" Background="#1F0078D4" VerticalAlignment="Center">
                                <Viewbox Width="17" Height="17" TextElement.Foreground="#3B9BEB">
                                    <Path Style="{StaticResource CardIconPath}" Data="{StaticResource CardIconOcr}" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Chữ đã trích xuất" FontSize="14" FontWeight="SemiBold" Foreground="#E8EAED" />
                                <TextBlock Text="Có thể sửa trực tiếp trước khi sao chép lại" FontSize="11.5" Foreground="#9AA0A6" Margin="0,1,0,0" />
                            </StackPanel>
                            <Border Grid.Column="2" Margin="12,0,8,0" Padding="7,4" CornerRadius="4"
                                    BorderBrush="#26FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="Windows OCR · offline" FontFamily="Consolas" FontSize="11" Foreground="#9AA0A6" />
                            </Border>
                            <Button x:Name="OcrCloseIconButton"
                                    Grid.Column="3"
                                    Style="{StaticResource CardIconButton}"
                                    ToolTip="Đóng kết quả trích xuất chữ (Esc)"
                                    Click="OnOcrCloseClick">
                                <Viewbox Width="14" Height="14">
                                    <Path Style="{StaticResource CardIconPath}" StrokeThickness="2.2" Data="{StaticResource CardIconClose}" />
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Trạng thái: đã sao chép vào Clipboard -->
                    <Border Margin="16,12,16,0" Padding="10,7" CornerRadius="6"
                            Background="#1A22C55E" BorderBrush="#3322C55E" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" TextElement.Foreground="#4ADE80" VerticalAlignment="Center">
                                <Path Style="{StaticResource CardIconPath}" Data="{StaticResource CardIconCheckCircle}" />
                            </Viewbox>
                            <TextBlock x:Name="OcrCopiedText"
                                       Text="Đã sao chép toàn bộ văn bản vào Clipboard"
                                       Margin="8,0,0,0"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="#A7F3D0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Văn bản đã nhận diện (sửa được) -->
                    <TextBox x:Name="OcrResultTextBox"
                             Style="{StaticResource CardTextBox}"
                             Margin="16,10,16,0"
                             Height="190"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             IsReadOnly="False" />

                    <!-- Footer: thống kê + các nút thao tác -->
                    <Grid Margin="16,12,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OcrResultMetaText"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="#7D838B" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="OcrCopyAgainButton"
                                    Style="{StaticResource CardGhostButton}"
                                    ToolTip="Sao chép lại văn bản (kể cả phần bạn vừa sửa)"
                                    Click="OnOcrCopyAgainClick">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15"><Path Style="{StaticResource CardIconPath}" Data="{StaticResource CardIconCopy}" /></Viewbox>
                                    <TextBlock Text="Sao chép lại" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OcrContinueButton"
                                    Style="{StaticResource CardGhostButton}"
                                    ToolTip="Đóng thẻ này và tiếp tục chú thích ảnh"
                                    Click="OnOcrCloseClick">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15"><Path Style="{StaticResource CardIconPath}" Data="{StaticResource CardIconPencil}" /></Viewbox>
                                    <TextBlock Text="Tiếp tục chỉnh sửa" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OcrDoneButton"
                                    Style="{StaticResource CardPrimaryButton}"
                                    ToolTip="Hoàn tất và đóng màn hình chụp"
                                    Click="OnOcrDoneClick">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15"><Path Style="{StaticResource CardIconPath}" StrokeThickness="2.4" Data="{StaticResource CardIconCheck}" /></Viewbox>
                                    <TextBlock Text="Xong" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Kính lúp hiển thị màu và mã HEX khi dùng công cụ hút màu (Eyedropper) -->
            <Border x:Name="EyedropperLoupe"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Background="#E61E1E1E"
                    BorderBrush="#4DFFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6,5"
                    Effect="{DynamicResource {x:Static SystemParameters.DropShadow}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="LoupeColorSwatch"
                            Width="24"
                            Height="24"
                            CornerRadius="12"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1.5"
                            Margin="0,0,8,0"
                            Background="#FFE81123" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LoupeHexText"
                                   Text="#E81123"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="White" />
                        <TextBlock Text="Click để chọn màu"
                                   FontSize="9"
                                   Foreground="#A0FFFFFF" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
