<Window x:Class="NeatShot.Presentation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NeatShot.Common.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NeatShot.Presentation.ViewModels"
        xmlns:controls="clr-namespace:NeatShot.Presentation.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="{l:T Settings.WindowTitle}"
        Width="620"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] icon dùng chung · [1] bảng màu sáng/tối (đổi lúc chạy) · [2] style của cửa sổ Cài đặt -->
                <ResourceDictionary Source="pack://application:,,,/NeatShot;component/Presentation/Themes/NeatShotControls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/NeatShot;component/Presentation/Themes/SettingsTheme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/NeatShot;component/Presentation/Themes/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="18"
            Background="{DynamicResource StWindowBg}"
            BorderBrush="{DynamicResource StWindowBorder}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header kéo được -->
            <Border x:Name="HeaderBar" Padding="18,14,12,14" BorderBrush="{DynamicResource StDivider}" BorderThickness="0,0,0,1"
                    Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource StHeaderIconBg}">
                        <Viewbox Width="18" Height="18" TextElement.Foreground="{DynamicResource StHeaderIcon}">
                            <Path Style="{StaticResource CardIconPath}" Data="{StaticResource CardIconGear}" />
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:T Settings.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource StText}" />
                        <TextBlock Text="{l:T Settings.Subtitle}" FontSize="12" Foreground="{DynamicResource StMuted}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource StIconButton}" ToolTip="{l:T Common.CloseEsc}"
                            Command="{Binding CancelCommand}">
                        <Viewbox Width="14" Height="14">
                            <Path Style="{StaticResource CardIconPath}" StrokeThickness="2.2" Data="{StaticResource CardIconClose}" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- Nội dung: cuộn được để cửa sổ không bao giờ cao hơn màn hình -->
            <ScrollViewer x:Name="BodyScroller" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}" />
                </ScrollViewer.Resources>
                <StackPanel Margin="18,0,14,6">
                    <!-- ===== PHÍM TẮT ===== -->
                    <Grid Margin="0,16,0,8">
                        <TextBlock Text="{l:T Settings.SectionHotkeys}" Style="{StaticResource SettingsSectionTitle}" Margin="2,0,0,0" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource StGhostButton}" Height="28" Padding="10,0"
                                ToolTip="{l:T Settings.ResetHotkeysTip}" Command="{Binding ResetHotkeysCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13"><Path Style="{StaticResource CardIconPath}" Data="{StaticResource CardIconReset}" /></Viewbox>
                                <TextBlock Text="{l:T Settings.ResetHotkeys}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{l:T Settings.Capture}" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="{l:T Settings.CaptureHint}" Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                                <controls:HotkeyBox x:Name="CaptureHotkeyBox" Grid.Column="1" Width="230"
                                                    Gesture="{Binding CaptureHotkey}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{l:T Settings.CaptureAlt}" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="{l:T Settings.CaptureAltHint}" Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                                <controls:HotkeyBox x:Name="CaptureAlternateHotkeyBox" Grid.Column="1" Width="230"
                                                    Gesture="{Binding CaptureAlternateHotkey}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{l:T Settings.PinClipboard}" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="{l:T Settings.PinClipboardHint}" Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                                <controls:HotkeyBox x:Name="PinClipboardHotkeyBox" Grid.Column="1" Width="230"
                                                    Gesture="{Binding PinClipboardHotkey}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{l:T Settings.RepeatLast}" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="{l:T Settings.RepeatLastHint}" Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                                <controls:HotkeyBox x:Name="RepeatLastHotkeyBox" Grid.Column="1" Width="230"
                                                    Gesture="{Binding RepeatLastHotkey}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== LƯU ẢNH ===== -->
                    <TextBlock Text="{l:T Settings.SectionSaving}" Style="{StaticResource SettingsSectionTitle}" />
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{l:T Settings.Folder}" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock x:Name="SaveDirectoryText" Text="{Binding SaveDirectory}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                               Foreground="{DynamicResource StMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SaveDirectory}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource StGhostButton}" Click="OnBrowseFolderClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="15" Height="15"><Path Style="{StaticResource CardIconPath}" Data="{StaticResource CardIconFolder}" /></Viewbox>
                                        <TextBlock Text="{l:T Settings.ChangeFolder}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{l:T Settings.AutoSave}" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="{l:T Settings.AutoSaveHint}" Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                                <CheckBox x:Name="AutoSaveToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding AutoSaveToGallery}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{l:T Settings.Format}" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="{l:T Settings.FormatHint}" Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="PNG" GroupName="ImageFormat" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsPng}" />
                                        <RadioButton Content="JPG" GroupName="ImageFormat" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsJpg}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,12" Visibility="{Binding IsJpg, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l:T Settings.JpgQuality}" FontSize="12" Foreground="{DynamicResource StMuted}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Margin="14,0" Minimum="50" Maximum="100" SmallChange="1" LargeChange="5"
                                        IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource SettingsSlider}"
                                        Value="{Binding JpegQuality}" />
                                <TextBlock Grid.Column="2" Width="36" TextAlignment="Right" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           Foreground="{DynamicResource StText}" VerticalAlignment="Center" Text="{Binding JpegQuality, StringFormat={}{0}%}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== CHUNG ===== -->
                    <TextBlock Text="{l:T Settings.SectionGeneral}" Style="{StaticResource SettingsSectionTitle}" />
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{l:T Settings.Language}" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="{l:T Settings.LanguageHint}" Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="LanguageVietnameseOption" Content="{l:T Settings.LanguageVietnamese}" GroupName="Language" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsVietnamese}" />
                                        <RadioButton x:Name="LanguageEnglishOption" Content="{l:T Settings.LanguageEnglish}" GroupName="Language" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsEnglish}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{l:T Settings.Theme}" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="{l:T Settings.ThemeHint}" Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeSystemOption" Content="{l:T Settings.ThemeSystem}" GroupName="Theme" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsSystemTheme}" />
                                        <RadioButton x:Name="ThemeLightOption" Content="{l:T Settings.ThemeLight}" GroupName="Theme" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsLightTheme}" />
                                        <RadioButton x:Name="ThemeDarkOption" Content="{l:T Settings.ThemeDark}" GroupName="Theme" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsDarkTheme}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{l:T Settings.StartWithWindows}" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="{l:T Settings.StartWithWindowsHint}" Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                                <CheckBox x:Name="LaunchAtStartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding LaunchAtStartup}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{l:T Settings.AutoCopy}" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="{l:T Settings.AutoCopyHint}" Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                                <CheckBox x:Name="AutoCopyToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding AutoCopyOnCapture}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer cố định: trạng thái + nút -->
            <Border Grid.Row="2" Padding="18,14,18,16" BorderBrush="{DynamicResource StDivider}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap"
                               FontSize="12" Margin="0,0,12,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource StSuccess}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource StError}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource StGhostButton}" Command="{Binding CancelCommand}" Height="34">
                            <TextBlock Text="{l:T Common.Cancel}" />
                        </Button>
                        <Button x:Name="SaveButton" Style="{StaticResource CardPrimaryButton}" Command="{Binding SaveAndCloseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15"><Path Style="{StaticResource CardIconPath}" StrokeThickness="2.4" Data="{StaticResource CardIconCheck}" /></Viewbox>
                                <TextBlock Text="{l:T Common.Save}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
