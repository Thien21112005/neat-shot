<Window x:Class="NeatShot.Presentation.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/NeatShot;component/Presentation/Themes/NeatShotControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Đếm ngược chụp hẹn giờ: không lấy focus để menu bạn đang mở không bị đóng -->
    <Border Margin="16"
            Padding="10,8,8,8"
            Background="#F716181D"
            BorderBrush="#24FFFFFF"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Grid Width="40" Height="40">
                <Ellipse Stroke="#26FFFFFF" StrokeThickness="3" />
                <Ellipse x:Name="ProgressRing" Stroke="#0078D4" StrokeThickness="3" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="SecondsText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="White" />
            </Grid>
            <StackPanel Margin="12,0,18,0" VerticalAlignment="Center">
                <TextBlock Text="Chụp hẹn giờ" FontSize="13" FontWeight="SemiBold" Foreground="#E8EAED" />
                <TextBlock Text="Mở menu cần chụp · Esc để huỷ" FontSize="11.5" Foreground="#9AA0A6" Margin="0,2,0,0" />
            </StackPanel>
            <Button x:Name="CancelButton"
                    Style="{StaticResource CardIconButton}"
                    VerticalAlignment="Center"
                    ToolTip="Huỷ chụp hẹn giờ (Esc)"
                    Click="OnCancelClick">
                <Viewbox Width="13" Height="13">
                    <Path Style="{StaticResource CardIconPath}" StrokeThickness="2.2" Data="{StaticResource CardIconClose}" />
                </Viewbox>
            </Button>
        </StackPanel>
    </Border>
</Window>
